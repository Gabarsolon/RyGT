+inline float4x4 transpose(const float4x4& m)
+{
+    float4x4 r;
+    r[0] = { m[0].x, m[1].x, m[2].x, m[3].x };
+    r[1] = { m[0].y, m[1].y, m[2].y, m[3].y };
+    r[2] = { m[0].z, m[1].z, m[2].z, m[3].z };
+    r[3] = { m[0].w, m[1].w, m[2].w, m[3].w };
+    return r;
+};
