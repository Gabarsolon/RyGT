+//! Specifies feature requirement flags
+//! 
+enum class FeatureRequirementFlags : uint32_t
+{
+    //! Rendering APIs
+    eD3D11Supported = 1 << 0,
+    eD3D12Supported = 1 << 1,
+    eVulkanSupported = 1 << 2,
