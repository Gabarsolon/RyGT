From e9cc3464fe29cd37f2e95c6657f5f1920a7cbdd6 Mon Sep 17 00:00:00 2001
From: mlgprorektm8 <67933lance@gmail.com>
Date: Fri, 16 Oct 2026 15:14:59 -0500
Subject: [PATCH] Quality presets: image recycle budget from the launcher
 (GPU.image_recycle_mb)

Common::RytyGameConfigValue reads the launcher's game settings. The image
recycle pool's budget comes from GPU.image_recycle_mb (or
SHADGT_IMAGE_RECYCLE_MB); 0 turns reuse off. Tokyo rain race, committed memory:
High (driver cache, 512 MB) ~11 GB average / 13.5 GB peak, Low (no driver cache,
128 MB) 8.6 / 9.0 GB.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/ryty_config.h               | 63 ++++++++++++++++++++++++++
 src/video_core/texture_cache/image.cpp | 19 ++++++--
 2 files changed, 79 insertions(+), 3 deletions(-)
 create mode 100644 src/common/ryty_config.h

diff --git a/src/common/ryty_config.h b/src/common/ryty_config.h
new file mode 100644
index 00000000..0dd77402
--- /dev/null
+++ b/src/common/ryty_config.h
@@ -0,0 +1,63 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstdio>
+#include <optional>
+#include <string>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace Common {
+
+/// The launcher's game settings (user\custom_configs\CUSA03220.json next to the exe), read once.
+inline const std::string& RytyGameConfigText() {
+    static const std::string text = [] {
+        std::string result;
+#ifdef _WIN32
+        char path[MAX_PATH];
+        const DWORD length = GetModuleFileNameA(nullptr, path, MAX_PATH);
+        if (length == 0 || length >= MAX_PATH) {
+            return result;
+        }
+        std::string config{path, length};
+        config = config.substr(0, config.find_last_of("\\/") + 1) +
+                 "user\\custom_configs\\CUSA03220.json";
+        if (std::FILE* file = std::fopen(config.c_str(), "rb")) {
+            char chunk[4096];
+            while (const size_t n = std::fread(chunk, 1, sizeof(chunk), file)) {
+                result.append(chunk, n);
+            }
+            std::fclose(file);
+        }
+#endif
+        return result;
+    }();
+    return text;
+}
+
+/// The raw value after "key": in the launcher's settings (true, false, a number), if present.
+inline std::optional<std::string> RytyGameConfigValue(const char* key) {
+    const std::string& text = RytyGameConfigText();
+    const std::string quoted = std::string{"\""} + key + "\"";
+    const size_t at = text.find(quoted);
+    if (at == std::string::npos) {
+        return std::nullopt;
+    }
+    const size_t begin = text.find_first_not_of(" \t\r\n:", at + quoted.size());
+    if (begin == std::string::npos) {
+        return std::nullopt;
+    }
+    const size_t end = text.find_first_of(",}\r\n", begin);
+    return text.substr(begin, end == std::string::npos ? std::string::npos : end - begin);
+}
+
+} // namespace Common
diff --git a/src/video_core/texture_cache/image.cpp b/src/video_core/texture_cache/image.cpp
index 9e49ae1d..d25255b5 100644
--- a/src/video_core/texture_cache/image.cpp
+++ b/src/video_core/texture_cache/image.cpp
@@ -14,6 +14,7 @@
 #include <string>
 #include "common/assert.h"
 #include "common/logging/log.h"
+#include "common/ryty_config.h"
 #include "video_core/renderer_vulkan/liverpool_to_vk.h"
 #include "video_core/renderer_vulkan/vk_instance.h"
 #include "video_core/renderer_vulkan/vk_runtime.h"
@@ -219,7 +220,19 @@ u64 g_recycle_seq = 0;
 std::mutex g_recycle_mutex;
 std::unordered_map<RecycleKey, std::vector<RecycledImage>, RecycleKeyHash> g_recycled;
 u64 g_recycled_bytes = 0;
-constexpr u64 RecycleBudget = 512ULL << 20;
+// GPU.image_recycle_mb (launcher quality preset) or SHADGT_IMAGE_RECYCLE_MB; 512 by default.
+u64 RecycleBudgetBytes() {
+    static const u64 budget = [] {
+        if (const char* env = std::getenv("SHADGT_IMAGE_RECYCLE_MB"); env && *env) {
+            return std::strtoull(env, nullptr, 10) << 20;
+        }
+        if (const auto value = Common::RytyGameConfigValue("image_recycle_mb")) {
+            return std::strtoull(value->c_str(), nullptr, 10) << 20;
+        }
+        return u64{512} << 20;
+    }();
+    return budget;
+}
 constexpr size_t RecyclePerKey = 8;
 std::atomic<u64> g_recycle_hits{}, g_recycle_misses{}, g_recycle_dropped{};
 
@@ -240,7 +253,7 @@ RecycleKey KeyOf(const vk::ImageCreateInfo& ci) {
 /// Keeps the image for reuse; false when it should be destroyed instead.
 bool Recycle(VmaAllocator allocator, const vk::ImageCreateInfo& ci, VmaAllocation allocation,
              vk::Image image, vk::DeviceSize size_bytes) {
-    if (!RecycleEnabled() || ci.pNext != nullptr || size_bytes > (64ULL << 20)) {
+    if (!RecycleEnabled() || ci.pNext != nullptr || size_bytes > (64ULL << 20) || RecycleBudgetBytes() == 0) {
         return false;
     }
     std::scoped_lock lk{g_recycle_mutex};
@@ -251,7 +264,7 @@ bool Recycle(VmaAllocator allocator, const vk::ImageCreateInfo& ci, VmaAllocatio
         return false;
     }
     // Over budget: the images waiting longest go (most were made once, e.g. while loading).
-    while (g_recycled_bytes + size_bytes > RecycleBudget && !g_recycle_order.empty()) {
+    while (g_recycled_bytes + size_bytes > RecycleBudgetBytes() && !g_recycle_order.empty()) {
         const auto [old_key, old_seq] = g_recycle_order.front();
         g_recycle_order.pop_front();
         auto& old_list = g_recycled[old_key];
-- 
