From da4e1cd25d603edb7582ea53512660cfa6101525 Mon Sep 17 00:00:00 2001
From: mlgprorektm8 <67933lance@gmail.com>
Date: Tue, 20 Oct 2026 10:39:19 -0500
Subject: [PATCH] Apply RyGT's VMA patches to externals/vma at configure time

externals/vma-patches/0001-trim-empty-default-blocks.patch (by xacidr4inx, RyGT
renderer/vma-patches) adds VmaBlockVector::TrimEmptyBlocks, which the cumulative-unmaps change
calls; CMake applies it to the submodule's checkout when it is missing, so the branch builds as
it is.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 externals/CMakeLists.txt                      | 16 +++++++
 externals/vma-patches/.gitattributes          |  2 +
 .../0001-trim-empty-default-blocks.patch      | 46 +++++++++++++++++++
 3 files changed, 64 insertions(+)
 create mode 100644 externals/vma-patches/.gitattributes
 create mode 100644 externals/vma-patches/0001-trim-empty-default-blocks.patch

diff --git a/externals/CMakeLists.txt b/externals/CMakeLists.txt
index e8758d7f..0ef752e3 100644
--- a/externals/CMakeLists.txt
+++ b/externals/CMakeLists.txt
@@ -92,6 +92,22 @@ endif()
 
 # VMA
 if (NOT TARGET GPUOpen::VulkanMemoryAllocator)
+    # ryGT: patches to VMA (vma-patches/*.patch, e.g. trimming empty default-pool blocks, which
+    # the renderer's unmap handling calls) are applied to the submodule's checkout when missing.
+    file(GLOB VMA_PATCHES "${CMAKE_CURRENT_SOURCE_DIR}/vma-patches/*.patch")
+    foreach(VMA_PATCH ${VMA_PATCHES})
+        execute_process(COMMAND git apply --reverse --check "${VMA_PATCH}"
+                        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/vma"
+                        RESULT_VARIABLE VMA_PATCH_PRESENT OUTPUT_QUIET ERROR_QUIET)
+        if (NOT VMA_PATCH_PRESENT EQUAL 0)
+            execute_process(COMMAND git apply "${VMA_PATCH}"
+                            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/vma"
+                            RESULT_VARIABLE VMA_PATCH_APPLIED)
+            if (NOT VMA_PATCH_APPLIED EQUAL 0)
+                message(FATAL_ERROR "Could not apply ${VMA_PATCH} to externals/vma")
+            endif()
+        endif()
+    endforeach()
     add_subdirectory(vma)
 endif()
 
diff --git a/externals/vma-patches/.gitattributes b/externals/vma-patches/.gitattributes
new file mode 100644
index 00000000..6213c29c
--- /dev/null
+++ b/externals/vma-patches/.gitattributes
@@ -0,0 +1,2 @@
+# ryGT: patches applied with git apply keep LF line endings on every checkout.
+*.patch text eol=lf
diff --git a/externals/vma-patches/0001-trim-empty-default-blocks.patch b/externals/vma-patches/0001-trim-empty-default-blocks.patch
new file mode 100644
index 00000000..767483c3
--- /dev/null
+++ b/externals/vma-patches/0001-trim-empty-default-blocks.patch
@@ -0,0 +1,46 @@
+--- a/include/vk_mem_alloc.h
++++ b/include/vk_mem_alloc.h
+@@ -9842,6 +9842,8 @@
+         VmaAllocation* pAllocations);
+ 
+     void Free(VmaAllocation hAllocation);
++    // ryGT: trim only completely empty default-pool blocks after an unload grace period.
++    VkDeviceSize TrimEmptyBlocks();
+ 
+ #if VMA_STATS_STRING_ENABLED
+     void PrintDetailedMap(class VmaJsonWriter& json);
+@@ -11682,6 +11684,34 @@
+     }
+ }
+ 
++VkDeviceSize VmaBlockVector::TrimEmptyBlocks()
++{
++    VkDeviceSize freed = 0;
++    for (;;)
++    {
++        VmaDeviceMemoryBlock* drop = VMA_NULL;
++        {
++            VmaMutexLockWrite lock(m_Mutex, m_hAllocator->m_UseMutex);
++            if (m_Blocks.size() <= m_MinBlockCount) break;
++            for (size_t i = m_Blocks.size(); i--; )
++            {
++                if (m_Blocks[i]->m_pMetadata->IsEmpty())
++                {
++                    drop = m_Blocks[i];
++                    freed += drop->m_pMetadata->GetSize();
++                    Remove(drop);
++                    break;
++                }
++            }
++        }
++        if (drop == VMA_NULL) break;
++        // Match Free(): destruction outside the vector lock.
++        drop->Destroy(m_hAllocator);
++        vma_delete(m_hAllocator, drop);
++    }
++    return freed;
++}
++
+ VkDeviceSize VmaBlockVector::CalcMaxBlockSize() const
+ {
+     VkDeviceSize result = 0;
-- 
