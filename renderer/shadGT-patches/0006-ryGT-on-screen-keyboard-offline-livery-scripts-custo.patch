+    if (!(std::getenv("RYGT_DECALS") && std::getenv("RYGT_DECALS")[0] == '0')) {
+        SyncDecals();
+    }
     auto* base = reinterpret_cast<u8*>(GetModuleHandleA(nullptr));
     char buffer[4096];
     const DWORD length = GetEnvironmentVariableA("RYGT_PATCH", buffer, sizeof(buffer));
