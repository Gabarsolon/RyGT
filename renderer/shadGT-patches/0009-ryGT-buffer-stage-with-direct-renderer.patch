From 7ae78538e40d941b19d5ee0bfd66244a672e3a8f Mon Sep 17 00:00:00 2001
From: mlgprorektm8 <67933lance@gmail.com>
Date: Fri, 16 Oct 2026 10:51:39 -0500
Subject: [PATCH] D9: buffer stage thread on by default with the direct
 renderer

The stage skips buffers the recorder reads in place, so its plans line up with
BindBuffers. Tokyo rain: 45.3/45.1/44.1 fps vs ~43.4 without it (recorder
81% -> 73-81% busy). SHADGT_BUFFER_STAGE=0 turns it off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/video_core/amdgpu/draw_pipe.cpp              | 9 +++++++--
 src/video_core/renderer_vulkan/vk_rasterizer.cpp | 4 ++++
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/video_core/amdgpu/draw_pipe.cpp b/src/video_core/amdgpu/draw_pipe.cpp
index 63f5d42d..bfedb61a 100644
--- a/src/video_core/amdgpu/draw_pipe.cpp
+++ b/src/video_core/amdgpu/draw_pipe.cpp
@@ -12,6 +12,7 @@
 #include "common/nvtx.h"
 #include "common/perf_monitor.h"
 #include "common/thread.h"
+#include "video_core/buffer_cache/direct_memory.h"
 #include "video_core/amdgpu/draw_pipe.h"
 
 namespace AmdGpu {
@@ -33,8 +34,12 @@ DrawPipe::DrawPipe(std::function<void()> thread_init_, size_t max_pending_)
     }
     // PERF-067: the buffer stage thread does each draw's buffer work ahead of the recorder.
     // -DisablePerf 74 keeps it off.
-    if (const char* env = std::getenv("SHADGT_BUFFER_STAGE");
-        env && env[0] == '1' && Common::PerfFeatureEnabled(74)) {
+    // D9: on by default with the direct renderer (its recorder obtains far fewer buffers, so the
+    // stage's plans are rarely refused: Tokyo rain 45.2 fps vs 43.4); =0 turns it off.
+    const char* stage_env = std::getenv("SHADGT_BUFFER_STAGE");
+    const bool stage_wanted = stage_env && *stage_env ? stage_env[0] == '1'
+                                                      : VideoCore::DirectMemory::Enabled();
+    if (stage_wanted && Common::PerfFeatureEnabled(74)) {
         stage_enabled = true;
         if (const char* workers_env = std::getenv("SHADGT_STAGE_WORKERS")) {
             worker_count = static_cast<u32>(std::clamp(std::atoi(workers_env), 1, 4));
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index c0437942..0707a91e 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -769,6 +769,10 @@ bool Rasterizer::PrepareBuffersAhead(const SelectedPipeline& selected, BufferPla
             if (order_only && !desc.is_written) {
                 continue;
             }
+            // D9: read in place by the recorder (BindBuffers), not obtained.
+            if (info->uses_direct && desc.IsDirectEligible() && buffer_cache.GetDirectMemory()) {
+                continue;
+            }
             if (!order_only && written_to_recorder && desc.is_written) {
                 ++plan_refusals[3];
                 if (!skip_written) {
-- 
