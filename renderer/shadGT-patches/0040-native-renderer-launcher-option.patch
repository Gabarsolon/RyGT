@@ -0,0 +1,47 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// NAT-001: hooks on the entry of functions in the converted game (GTSport.exe). The function's
+// first instructions are moved to a trampoline and replaced by a jump, so every call reaches the
+// hook, whichever call site or tail jump it comes from. The moved bytes must be whole,
+// position-independent instructions that nothing branches into; the caller passes them and they
+// are checked before anything is written.
+
+#pragma once
+
+#include <atomic>
+#include <span>
+
+#include "common/types.h"
+
+namespace Native {
+
+/// GTSport.exe RVA of an address in the game's eboot.bin (the converter moves the code by this).
+constexpr u64 kEbootToExe = 0x10000;
+
+/// Executable memory within +-2 GB of the game's code, so rel32 jumps reach it.
+class NearCode {
+public:
+    explicit NearCode(u8* exe_base) : exe_base{exe_base} {}
+    /// 64-byte aligned, zeroed, executable and writable; nullptr when nothing near is free.
+    u8* Alloc(size_t size);
+
+private:
+    u8* exe_base;
+    u8* block = nullptr;
+    size_t used = 0;
+};
+
+/// Makes the function at eboot address `eboot_va` jump to `hook`. `prologue` is the function's
+/// first instructions (at least 5 bytes) as the game has them. Returns a pointer that runs the
+/// original function (the moved instructions, then a jump back), or nullptr when the bytes
+/// differ or no memory was found. Must run before the game's code does (DllMain).
+void* HookEntry(NearCode& code, u8* exe_base, u64 eboot_va, std::span<const u8> prologue,
+                void* hook, const char* name);
+
+/// Like HookEntry, but the hook is a machine-code stub that only increments the returned
+/// counter and continues into the original function: no registers or arguments are touched.
+std::atomic<u64>* CountEntry(NearCode& code, u8* exe_base, u64 eboot_va,
+                             std::span<const u8> prologue, const char* name);
+
+} // namespace Native
diff --git a/ryty_gpu/native/gts_hooks.cpp b/ryty_gpu/native/gts_hooks.cpp
new file mode 100644
index 00000000..25643cf5
--- /dev/null
+++ b/ryty_gpu/native/gts_hooks.cpp
@@ -0,0 +1,371 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// NAT-002: where GT Sport's graphics reach the GPU (static analysis of eboot.bin v1.69). The game
+// draws through PGL, Polyphony's OpenGL-like layer over Sony's statically linked Gnm library:
+// - every draw goes through one of five PGL functions, which end in Gnm's drawIndexAuto or
+//   drawIndex wrapper (nothing else calls those wrappers);
+// - no game code writes GPU commands itself, apart from PGL's links between command chunks;
+// - compute dispatches go through four Gnm wrappers, and every graphics frame is submitted by one
+//   PGL function.
+// With RYGT_NATIVE_HOOKS=1 these functions are hooked and counted. Every 10 seconds the counts are
+// logged next to the draws and dispatches the renderer received (NAT-002 lines), to check that the
+// hooks see everything before a native renderer relies on them. Nothing else changes.
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+#include <intrin.h>
+#include <windows.h>
+#include <fmt/format.h>
+
+#include "common/logging/log.h"
+#include "common/perf_monitor.h"
+#include "ryty_gpu/native/entry_hook.h"
+#include "ryty_gpu/native/gts_hooks.h"
+#include "ryty_gpu/native/shadow.h"
+
+namespace Native {
+namespace {
+
+// The first instructions of the hooked functions (moved to their trampolines).
+constexpr std::array<u8, 6> kPushR15 = {0x55, 0x48, 0x89, 0xe5, 0x41, 0x57}; // push rbp; mov rbp,rsp; push r15
+constexpr std::array<u8, 6> kPushR14 = {0x55, 0x48, 0x89, 0xe5, 0x41, 0x56}; // ...; push r14
+constexpr std::array<u8, 5> kPushRbx = {0x55, 0x48, 0x89, 0xe5, 0x53};       // ...; push rbx
+
+enum DrawKind : int { Arrays, ArraysInstanced, Triangles32, Elements, Immediate, kDrawKinds };
+
+struct DrawEntry {
+    u64 eboot_va;
+    const char* name;
+    const char* label;
+};
+constexpr DrawEntry kDraws[kDrawKinds] = {
+    {0x1c5a750, "PGL drawArrays(mode, first, count)", "arrays"},
+    {0x1c5a890, "PGL drawArraysInstanced(mode, first, count, instances)", "instanced"},
+    {0x1c5a9e0, "PGL drawTriangles32(count, indices)", "triangles32"},
+    {0x1c5ab00, "PGL drawElements(mode, count, type, indices, offset, instances)", "elements"},
+    {0x1c621b0, "PGL immediate-mode draw", "immediate"},
+};
+
+// Draw counts per game thread: which threads record draws, and how many.
+struct ThreadCounts {
+    std::atomic<u64> draws[kDrawKinds]{};
+    u32 tid = 0;
+    std::string name;
+    u64 reported = 0; // total at the previous report (reporter thread only)
+};
+std::mutex g_threads_mutex;
+std::vector<ThreadCounts*> g_threads;
+thread_local ThreadCounts* t_counts = nullptr;
+
+ThreadCounts& Counts() {
+    if (t_counts == nullptr) {
+        auto* counts = new ThreadCounts;
+        counts->tid = GetCurrentThreadId();
+        PWSTR description = nullptr;
+        if (SUCCEEDED(GetThreadDescription(GetCurrentThread(), &description)) && description) {
+            for (const wchar_t* c = description; *c; ++c) {
+                counts->name += *c < 128 ? static_cast<char>(*c) : '?';
+            }
+            LocalFree(description);
+        }
+        std::scoped_lock lock{g_threads_mutex};
+        g_threads.push_back(counts);
+        t_counts = counts;
+    }
+    return *t_counts;
+}
+
+// The PGL draw functions take at most six integer arguments; all six registers are passed on.
+using DrawFn = void(PS4_SYSV_ABI*)(u64, u64, u64, u64, u64, u64);
+DrawFn g_draw_original[kDrawKinds]{};
+
+// The renderer's log is ready once the game draws, so the reporter starts with the first draw.
+std::atomic<bool> g_reporter_started{false};
+void StartReporter();
+
+template <int Kind>
+void PS4_SYSV_ABI DrawHook(u64 a, u64 b, u64 c, u64 d, u64 e, u64 f) {
+    Counts().draws[Kind].fetch_add(1, std::memory_order_relaxed);
+    if (!g_reporter_started.load(std::memory_order_relaxed)) {
+        StartReporter();
+    }
+    g_draw_original[Kind](a, b, c, d, e, f);
+}
+
+struct CountEntryInfo {
+    u64 eboot_va;
+    std::span<const u8> prologue;
+    const char* name;
+    std::atomic<u64>* counter = nullptr;
+};
+enum CountKind : int {
+    GnmDrawIndexAuto,
+    GnmDrawIndex,
+    GnmDispatchGfx,
+    GnmDispatchAsync,
+    GnmDispatchB,
+    GnmDispatchC,
+    PglSubmit,
+    kCountKinds
+};
+CountEntryInfo g_counts[kCountKinds] = {
+    {0x1b4890, kPushR14, "Gnm drawIndexAuto wrapper"},
+    {0x1b4aa0, kPushR15, "Gnm drawIndex wrapper"},
+    {0x1b53c0, kPushR15, "Gnm dispatch (graphics ring)"},
+    {0x1d97d0, kPushR15, "Gnm dispatch (compute rings)"},
+    {0x1cafa0, kPushRbx, "Gnm dispatch (b)"},
+    {0x1db650, kPushRbx, "Gnm dispatch (c)"},
+    {0x1c56610, kPushR14, "PGL submit"},
+};
+
+u64 Count(CountKind kind) {
+    return g_counts[kind].counter ? g_counts[kind].counter->load(std::memory_order_relaxed) : 0;
+}
+
+// A render job takes a PGL context from a pool and makes it current on its thread with a fresh
+// command chunk and state from a template (job begin, context in the first argument); job end
+// links the job's chunks after the previous job's and restores the previous context.
+constexpr u64 kPglJobBegin = 0x1c572c0;
+constexpr u64 kPglJobEnd = 0x1c57860;
+constexpr u32 kPglContextDcb = 0x780; // the context's Gnm DrawCommandBuffer
+using JobFn = u64(PS4_SYSV_ABI*)(u64, u64, u64, u64, u64, u64);
+JobFn g_job_begin = nullptr;
+JobFn g_job_end = nullptr;
+std::atomic<u64> g_jobs{0};
+
+// Ryty's converted code reaches guest TLS through stubs in .gtcode that compute the thread
+// pointer: mov ecx, [rip + index]; mov rax, gs:[0x58]; mov rax, [rax + rcx*8];
+// lea rax, [rax + block size]. PGL keeps the current context just below it.
+struct GuestTls {
+    const u32* index = nullptr;
+    u32 block_size = 0;
+};
+GuestTls g_tls{};
+std::atomic<bool> g_tls_ok{false};
+
+GuestTls FindGuestTls(u8* exe_base) {
+    static constexpr u8 kStub[] = {0x65, 0x48, 0x8b, 0x04, 0x25, 0x58, 0x00, 0x00,
+                                   0x00, 0x48, 0x8b, 0x04, 0xc8, 0x48, 0x8d, 0x80};
+    const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(exe_base);
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(exe_base + dos->e_lfanew);
+    const IMAGE_SECTION_HEADER* sections = IMAGE_FIRST_SECTION(nt);
+    for (u32 i = 0; i < nt->FileHeader.NumberOfSections; ++i) {
+        if (std::memcmp(sections[i].Name, ".gtcode", 8) != 0) {
+            continue;
+        }
+        const u8* begin = exe_base + sections[i].VirtualAddress;
+        const u8* end = begin + sections[i].Misc.VirtualSize;
+        for (const u8* p = begin + 6; p + sizeof(kStub) + 4 <= end; ++p) {
+            if (p[-6] == 0x8b && p[-5] == 0x0d && std::memcmp(p, kStub, sizeof(kStub)) == 0) {
+                s32 rel;
+                std::memcpy(&rel, p - 4, sizeof(rel));
+                GuestTls tls;
+                tls.index = reinterpret_cast<const u32*>(p + rel);
+                std::memcpy(&tls.block_size, p + sizeof(kStub), sizeof(tls.block_size));
+                return tls;
+            }
+        }
+    }
+    return {};
+}
+
+u8* CurrentPglContext() {
+    auto* const* blocks = reinterpret_cast<u8* const*>(__readgsqword(0x58));
+    u8* const tp = blocks[*g_tls.index] + g_tls.block_size;
+    return *reinterpret_cast<u8**>(tp - 8);
+}
+
+// PGL creates a job by forking the current context (returns the child context): the parent's
+// commands stop at a 16-byte link slot that will lead into the child's commands and go on after
+// it, linked after the child's last chunk (NAT-006).
+constexpr u64 kPglFork = 0x1c56770;
+JobFn g_fork = nullptr;
+u64 g_exe_base = 0;
+std::atomic<u64> g_tls_mismatches{0};
+
+u64 PS4_SYSV_ABI JobBeginHook(u64 context, u64 b, u64 c, u64 d, u64 e, u64 f) {
+    const u64 result = g_job_begin(context, b, c, d, e, f);
+    g_jobs.fetch_add(1, std::memory_order_relaxed);
+    if (ShadowEnabled()) {
+        // Job begin makes the context current: a check of the guest TLS lookup.
+        if (g_tls_ok.load(std::memory_order_relaxed) &&
+            CurrentPglContext() != reinterpret_cast<u8*>(context) &&
+            g_tls_mismatches.fetch_add(1) == 0) {
+            g_tls_ok = false;
+            LOG_ERROR(Lib_GnmDriver, "NAT-006: guest TLS lookup gives {} at job begin, not {}; "
+                                     "forks are not followed",
+                      fmt::ptr(CurrentPglContext()), fmt::ptr(reinterpret_cast<u8*>(context)));
+        }
+        ShadowJobBegin(reinterpret_cast<const u8*>(context) + kPglContextDcb);
+    }
+    return result;
+}
+
+u64 PS4_SYSV_ABI ForkHook(u64 a, u64 b, u64 c, u64 d, u64 e, u64 f) {
+    if (!ShadowEnabled() || !g_tls_ok.load(std::memory_order_relaxed)) {
+        return g_fork(a, b, c, d, e, f);
+    }
+    const u8* parent = CurrentPglContext();
+    // The parent's command buffer pointers: begin, end, write pointer (the fork's link slot).
+    const auto* dcb = parent ? reinterpret_cast<const u32* const*>(parent + kPglContextDcb)
+                             : nullptr;
+    const u32* run_begin = dcb ? dcb[0] : nullptr;
+    const u32* run_limit = dcb ? dcb[1] : nullptr;
+    const u32* slot = dcb ? dcb[2] : nullptr;
+    const u64 caller = reinterpret_cast<u64>(__builtin_return_address(0)) - g_exe_base - 0x10000;
+    const u64 child = g_fork(a, b, c, d, e, f);
+    ShadowFork(parent, slot, run_begin, run_limit, reinterpret_cast<const u8*>(child), caller);
+    return child;
+}
+
+u64 PS4_SYSV_ABI JobEndHook(u64 a, u64 b, u64 c, u64 d, u64 e, u64 f) {
+    if (!ShadowEnabled()) {
+        return g_job_end(a, b, c, d, e, f);
+    }
+    ShadowJobEnd(g_tls_ok.load(std::memory_order_relaxed) ? CurrentPglContext() : nullptr);
+    const u64 result = g_job_end(a, b, c, d, e, f);
+    ShadowJobDecode();
+    return result;
+}
+
+void ReporterLoop() {
+    using namespace std::chrono_literals;
+    const auto& work = Common::GetWorkCounters();
+    u64 last_draws[kDrawKinds]{}, last_gnm = 0, last_dispatch = 0, last_submits = 0, last_jobs = 0;
+    u64 last_renderer_draws = work.draws.load(), last_renderer_dispatches = work.dispatches.load();
+    u64 start_renderer_draws = last_renderer_draws, start_renderer_dispatches = last_renderer_dispatches;
+    while (true) {
+        std::this_thread::sleep_for(10s);
+        u64 draws[kDrawKinds]{};
+        std::vector<std::pair<u64, std::string>> threads;
+        {
+            std::scoped_lock lock{g_threads_mutex};
+            for (ThreadCounts* counts : g_threads) {
+                u64 total = 0;
+                for (int kind = 0; kind < kDrawKinds; ++kind) {
+                    const u64 value = counts->draws[kind].load(std::memory_order_relaxed);
+                    draws[kind] += value;
+                    total += value;
+                }
+                if (total > counts->reported) {
+                    threads.emplace_back(total - counts->reported,
+                                         fmt::format("{} {}", counts->tid,
+                                                     counts->name.empty() ? "?" : counts->name));
+                }
+                counts->reported = total;
+            }
+        }
+        u64 game_draws = 0, window_draws = 0;
+        std::string by_kind;
+        for (int kind = 0; kind < kDrawKinds; ++kind) {
+            game_draws += draws[kind];
+            window_draws += draws[kind] - last_draws[kind];
+            by_kind += fmt::format(" {} {}", kDraws[kind].label, draws[kind] - last_draws[kind]);
+            last_draws[kind] = draws[kind];
+        }
+        const u64 gnm = Count(GnmDrawIndexAuto) + Count(GnmDrawIndex);
+        const u64 dispatch = Count(GnmDispatchGfx) + Count(GnmDispatchAsync) + Count(GnmDispatchB) +
+                             Count(GnmDispatchC);
+        const u64 submits = Count(PglSubmit);
+        const u64 jobs = g_jobs.load(std::memory_order_relaxed);
+        const u64 renderer_draws = work.draws.load(std::memory_order_relaxed);
+        const u64 renderer_dispatches = work.dispatches.load(std::memory_order_relaxed);
+        // Totals since the hooks' first report window: the renderer gets a frame's draws after
+        // the game submits it, so a small, steady difference is work in flight. A growing one
+        // means draws reach the GPU without passing the hooks.
+        LOG_INFO(Lib_GnmDriver,
+                 "NAT-002 hooks (10 s): game draws {} ({}), Gnm draw wrappers {}, renderer draws "
+                 "{}; dispatches game {} renderer {}; submits {}, render jobs {}. Since start: "
+                 "game draws {}, "
+                 "renderer draws {} (diff {}), game dispatches {}, renderer dispatches {} (diff {})",
+                 window_draws, by_kind.substr(1), gnm - last_gnm,
+                 renderer_draws - last_renderer_draws, dispatch - last_dispatch,
+                 renderer_dispatches - last_renderer_dispatches, submits - last_submits,
+                 jobs - last_jobs, game_draws, renderer_draws - start_renderer_draws,
+                 static_cast<s64>(renderer_draws - start_renderer_draws) - static_cast<s64>(game_draws),
+                 dispatch, renderer_dispatches - start_renderer_dispatches,
+                 static_cast<s64>(renderer_dispatches - start_renderer_dispatches) -
+                     static_cast<s64>(dispatch));
+        std::ranges::sort(threads, [](const auto& a, const auto& b) { return a.first > b.first; });
+        std::string line;
+        for (size_t i = 0; i < std::min<size_t>(threads.size(), 12); ++i) {
+            line += fmt::format(" [{}: {}]", threads[i].second, threads[i].first);
+        }
+        LOG_INFO(Lib_GnmDriver, "NAT-002 draw threads (10 s, {} threads):{}", threads.size(), line);
+        last_gnm = gnm;
+        last_dispatch = dispatch;
+        last_submits = submits;
+        last_jobs = jobs;
+        last_renderer_draws = renderer_draws;
+        last_renderer_dispatches = renderer_dispatches;
+    }
+}
+
+void StartReporter() {
+    if (!g_reporter_started.exchange(true)) {
+        std::thread{ReporterLoop}.detach();
+    }
+}
+
+} // namespace
+
+void InstallGtsHooks(u8* exe_base) {
+    const char* env = std::getenv("RYGT_NATIVE_HOOKS");
+    if ((!env || env[0] != '1') && !ShadowEnabled()) {
+        return;
+    }
+    static NearCode code{exe_base};
+    void* const hooks[kDrawKinds] = {
+        reinterpret_cast<void*>(&DrawHook<Arrays>),
+        reinterpret_cast<void*>(&DrawHook<ArraysInstanced>),
+        reinterpret_cast<void*>(&DrawHook<Triangles32>),
+        reinterpret_cast<void*>(&DrawHook<Elements>),
+        reinterpret_cast<void*>(&DrawHook<Immediate>),
+    };
+    int installed = 0;
+    for (int kind = 0; kind < kDrawKinds; ++kind) {
+        g_draw_original[kind] = reinterpret_cast<DrawFn>(
+            HookEntry(code, exe_base, kDraws[kind].eboot_va, kPushR15, hooks[kind], kDraws[kind].name));
+        installed += g_draw_original[kind] != nullptr;
+    }
+    for (CountEntryInfo& entry : g_counts) {
+        entry.counter = CountEntry(code, exe_base, entry.eboot_va, entry.prologue, entry.name);
+        installed += entry.counter != nullptr;
+    }
+    g_job_begin = reinterpret_cast<JobFn>(HookEntry(code, exe_base, kPglJobBegin, kPushR15,
+                                                    reinterpret_cast<void*>(&JobBeginHook),
+                                                    "PGL job begin"));
+    g_job_end = reinterpret_cast<JobFn>(HookEntry(code, exe_base, kPglJobEnd, kPushR15,
+                                                  reinterpret_cast<void*>(&JobEndHook),
+                                                  "PGL job end"));
+    installed += (g_job_begin != nullptr) + (g_job_end != nullptr);
+    int expected = static_cast<int>(kDrawKinds) + static_cast<int>(kCountKinds) + 2;
+    if (ShadowEnabled()) {
+        g_exe_base = reinterpret_cast<u64>(exe_base);
+        g_tls = FindGuestTls(exe_base);
+        if (g_tls.index != nullptr) {
+            g_fork = reinterpret_cast<JobFn>(HookEntry(code, exe_base, kPglFork, kPushR15,
+                                                       reinterpret_cast<void*>(&ForkHook),
+                                                       "PGL fork (job creation)"));
+            g_tls_ok = g_fork != nullptr;
+            installed += g_fork != nullptr;
+        }
+        ++expected;
+        std::fprintf(stderr, "[native] NAT-006: guest TLS index at %p, block size %#x\n",
+                     static_cast<const void*>(g_tls.index), g_tls.block_size);
+    }
+    std::fprintf(stderr, "[native] NAT-002: %d of %d hooks installed%s\n", installed, expected,
+                 ShadowEnabled() ? " (NAT-003 shadow mode)" : "");
+}
+
+} // namespace Native
