new file mode 100644
index 00000000..7e4cabc0
--- /dev/null
+++ b/ryty_gpu/native/job_walker.cpp
@@ -0,0 +1,382 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <memory>
+#include <span>
+#include <windows.h>
+
+#include "ryty_gpu/native/job_walker.h"
+#include "video_core/amdgpu/pm4_cmds.h"
+#include "video_core/amdgpu/regs.h"
+
+namespace Native {
+
+using AmdGpu::PM4ItOpcode;
+using AmdGpu::Regs;
+
+namespace {
+
+// Context registers whose writes carry a size hint in the NOP that follows them (the command
+// processor's ContextRegs).
+constexpr u32 kDbZInfo = 0xA010;
+constexpr std::array<u32, 8> kCbColorBase{0xA318, 0xA327, 0xA336, 0xA345,
+                                          0xA354, 0xA363, 0xA372, 0xA381};
+constexpr std::array<u32, 8> kCbColorCmask{0xA31F, 0xA32E, 0xA33D, 0xA34C,
+                                           0xA35B, 0xA36A, 0xA379, 0xA388};
+constexpr u32 kNopHeader = 0xc0001000;
+
+// The command processor's handling of those hints (liverpool.cpp, SetContextReg).
+void NoteExtentHints(u32 reg_addr, u32 count_field, const u32* payload, JobExtents& extents) {
+    for (u32 i = 0; i < 8; ++i) {
+        if (reg_addr == kCbColorBase[i]) {
+            const u32 nop_offset = count_field;
+            extents.cb[i].raw = (nop_offset == 0x0e || nop_offset == 0x0d || nop_offset == 0x0b) &&
+                                        payload[nop_offset] == kNopHeader
+                                    ? payload[nop_offset + 1]
+                                    : 0;
+            return;
+        }
+        if (reg_addr == kCbColorCmask[i]) {
+            if (count_field == 0x04 && payload[4] == kNopHeader) {
+                extents.cb[i].raw = payload[5];
+            }
+            return;
+        }
+    }
+    if (reg_addr == kDbZInfo) {
+        extents.db.raw = count_field == 8 && payload[20] == kNopHeader ? payload[21] : 0;
+    }
+}
+
+} // namespace
+
+namespace {
+// NAT-147: 64 KiB granules of the low 1 TiB known to be readable (committed, not no-access),
+// so the recorder's checks don't call VirtualQuery per draw (with many pages protected one by
+// one for write tracking, VirtualQuery walked them one region at a time: a quarter of the
+// recorder's time). Only "readable" is remembered; unmapping forgets it (ForgetReadable).
+constexpr u32 GranuleBits = 16;
+constexpr u64 Granules = (u64{1} << 40) >> GranuleBits;
+std::atomic<u64> readable_bits[Granules / 64];
+
+bool GranuleKnown(u64 granule) {
+    return granule < Granules &&
+           (readable_bits[granule / 64].load(std::memory_order_relaxed) >> (granule % 64)) & 1;
+}
+
+bool QueryReadable(const u8* p, const u8* end) {
+    while (p < end) {
+        MEMORY_BASIC_INFORMATION info{};
+        if (!VirtualQuery(p, &info, sizeof(info)) || info.State != MEM_COMMIT ||
+            (info.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0) {
+            return false;
+        }
+        p = static_cast<const u8*>(info.BaseAddress) + info.RegionSize;
+    }
+    return true;
+}
+
+// Whether the whole granule is readable (checked once, then remembered).
+bool GranuleReadable(u64 granule) {
+    if (GranuleKnown(granule)) {
+        return true;
+    }
+    if (granule >= Granules) {
+        return false;
+    }
+    const auto* begin = reinterpret_cast<const u8*>(granule << GranuleBits);
+    if (!QueryReadable(begin, begin + (u64{1} << GranuleBits))) {
+        return false;
+    }
+    readable_bits[granule / 64].fetch_or(u64{1} << (granule % 64), std::memory_order_relaxed);
+    return true;
+}
+} // namespace
+
+void ForgetReadable(u64 address, u64 size) {
+    if (size == 0) {
+        return;
+    }
+    for (u64 granule = address >> GranuleBits;
+         granule <= (address + size - 1) >> GranuleBits && granule < Granules; ++granule) {
+        readable_bits[granule / 64].fetch_and(~(u64{1} << (granule % 64)),
+                                               std::memory_order_relaxed);
+    }
+}
+
+u64 ReadablePrefix(const void* address, u64 size) {
+    {
+        // NAT-147: whole readable granules first.
+        const u64 begin = reinterpret_cast<u64>(address);
+        u64 granule = begin >> GranuleBits;
+        const u64 last = (begin + std::max<u64>(size, 1) - 1) >> GranuleBits;
+        while (granule <= last && GranuleReadable(granule)) {
+            ++granule;
+        }
+        if (granule > last) {
+            return size;
+        }
+    }
+    const u8* const start = static_cast<const u8*>(address);
+    const u8* p = start;
+    const u8* const end = start + size;
+    while (p < end) {
+        MEMORY_BASIC_INFORMATION info{};
+        if (!VirtualQuery(p, &info, sizeof(info)) || info.State != MEM_COMMIT ||
+            (info.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0) {
+            break;
+        }
+        p = static_cast<const u8*>(info.BaseAddress) + info.RegionSize;
+    }
+    return static_cast<u64>(std::min(p, end) - start);
+}
+
+bool Readable(const void* address, size_t size) {
+    {
+        // NAT-147: every granule of the range known readable (or found readable now).
+        const u64 begin = reinterpret_cast<u64>(address);
+        const u64 last = (begin + std::max<u64>(size, 1) - 1) >> GranuleBits;
+        bool all = true;
+        for (u64 granule = begin >> GranuleBits; granule <= last; ++granule) {
+            if (!GranuleReadable(granule)) {
+                all = false;
+                break;
+            }
+        }
+        if (all) {
+            return true;
+        }
+    }
+    // The range may span several regions (separate mappings, or pages protected differently).
+    const u8* p = static_cast<const u8*>(address);
+    const u8* const end = p + size;
+    while (p < end) {
+        MEMORY_BASIC_INFORMATION info{};
+        if (!VirtualQuery(p, &info, sizeof(info)) || info.State != MEM_COMMIT ||
+            (info.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0) {
+            return false;
+        }
+        p = static_cast<const u8*>(info.BaseAddress) + info.RegionSize;
+    }
+    return true;
+}
+
+namespace {
+
+// CLEAR_STATE: the command processor resets every register to its default
+// (AmdGpu::Regs::SetDefaults); the walk resets the graphics ones it keeps.
+void ClearState(Regs& regs) {
+    static const std::unique_ptr<Regs> defaults = [] {
+        auto r = std::make_unique<Regs>();
+        r->SetDefaults();
+        return r;
+    }();
+    constexpr std::array<std::pair<u32, u32>, 3> kRanges = {{
+        {Regs::ShRegWordOffset, 0x200},       // graphics stages (compute from 0x2E00 is apart)
+        {Regs::ContextRegWordOffset, 0x400},  // context
+        {Regs::UconfigRegWordOffset, 0x1000}, // primitive type, index type, instances...
+    }};
+    for (const auto& [first, count] : kRanges) {
+        std::memcpy(&regs.reg_array[first], &defaults->reg_array[first], count * sizeof(u32));
+    }
+}
+
+void NoteChunk(WalkStats& stats, const u32* begin, const u32* limit) {
+    if (stats.num_chunks < stats.chunks.size()) {
+        stats.chunks[stats.num_chunks] = {begin, limit};
+    }
+    ++stats.num_chunks;
+}
+
+} // namespace
+
+bool JobCursor::Fail(bool overrun, const char* reason, WalkStats& stats) {
+    (overrun ? stats.overrun : stats.bad_packet) = true;
+    stats.stop = p;
+    stats.reason = reason;
+    stats.stop_header = p != nullptr && p < limit ? *p : 0;
+    ok = false;
+    return false;
+}
+
+bool JobCursor::Start(const u32* begin, const u32* first_limit, WalkStats& stats) {
+    p = begin;
+    // 16 bytes beyond the command space hold the link to the next chunk.
+    limit = first_limit + 4;
+    ok = true;
+    if (begin == nullptr || limit <= begin || !Readable(begin, (limit - begin) * sizeof(u32))) {
+        return Fail(false, "first chunk not readable", stats);
+    }
+    NoteChunk(stats, begin, limit);
+    return true;
+}
+
+void JobCursor::SkipFork(const u32* next, const u32* next_limit, WalkStats& stats) {
+    if (!ok) {
+        return;
+    }
+    ++stats.forks;
+    // Usually the job goes on right after the link slot, in the chunk the walk is in.
+    const bool in_chunk = next == p + 4 && next_limit + 4 <= limit;
+    p = next;
+    limit = next_limit + 4;
+    if (in_chunk) {
+        return;
+    }
+    if (next == nullptr || limit <= next || !Readable(next, (limit - next) * sizeof(u32))) {
+        Fail(false, "chunk after a fork not readable", stats);
+        return;
+    }
+    NoteChunk(stats, next, limit);
+}
+
+bool JobCursor::WalkTo(const u32* until, Regs& regs, JobExtents& extents, JobVisitor& visitor,
+                       WalkStats& stats) {
+    constexpr u32 kComputeFirst = 0x200;
+    constexpr u32 kComputeLast = kComputeFirst + sizeof(AmdGpu::ComputeProgram) / sizeof(u32);
+    if (!ok) {
+        return false;
+    }
+    while (p != until) {
+        if (p >= limit) {
+            return Fail(true, "walked past the chunk without reaching the end", stats);
+        }
+        if (++stats.packets > (1u << 22)) {
+            return Fail(true, "too many packets", stats);
+        }
+        const u32 header = *p;
+        const u32 type = header >> 30;
+        if (type == 2) {
+            ++p;
+            continue;
+        }
+        if (type == 0) {
+            const u32 first = header & 0xffff;
+            const u32 count = ((header >> 16) & 0x3fff) + 1;
+            if (p + 1 + count > limit) {
+                return Fail(false, "type-0 packet crosses the chunk end", stats);
+            }
+            if (first + count <= Regs::NumRegs) {
+                std::memcpy(&regs.reg_array[first], p + 1, count * sizeof(u32));
+            }
+            p += count + 1;
+            continue;
+        }
+        if (type != 3) {
+            return Fail(false, "type-1 packet", stats);
+        }
+        const u32 count = ((header >> 16) & 0x3fff) + 1; // dwords after the header
+        if (p + 1 + count > limit) {
+            // packets never cross a chunk's end
+            return Fail(false, "packet crosses the chunk end", stats);
+        }
+        const auto opcode = static_cast<PM4ItOpcode>((header >> 8) & 0xff);
+        const u32* body = p + 1;
+        const auto set_regs = [&](u32 base) {
+            const u32 offset = body[0] & 0xffff;
+            if (count > 1 && base + offset + count - 1 <= Regs::NumRegs) {
+                std::memcpy(&regs.reg_array[base + offset], body + 1, (count - 1) * sizeof(u32));
+            }
+            return base + offset;
+        };
+        switch (opcode) {
+        case PM4ItOpcode::Nop:
+            break;
+        case PM4ItOpcode::SetContextReg: {
+            const u32 reg_addr = set_regs(Regs::ContextRegWordOffset);
+            NoteExtentHints(reg_addr, (header >> 16) & 0x3fff, body + 1, extents);
+            break;
+        }
+        case PM4ItOpcode::SetShReg: {
+            const u32 offset = body[0] & 0xffff;
+            if (offset < kComputeFirst || offset > kComputeLast) {
+                set_regs(Regs::ShRegWordOffset);
+            }
+            break;
+        }
+        case PM4ItOpcode::SetUconfigReg:
+            set_regs(Regs::UconfigRegWordOffset);
+            break;
+        case PM4ItOpcode::SetConfigReg:
+            set_regs(Regs::ConfigRegWordOffset);
+            break;
+        case PM4ItOpcode::IndexType:
+            regs.index_buffer_type.raw = body[0];
+            break;
+        case PM4ItOpcode::NumInstances:
+            regs.num_instances.num_instances = body[0];
+            break;
+        case PM4ItOpcode::IndexBase:
+            regs.index_base_address.base_addr_lo = body[0];
+            regs.index_base_address.base_addr_hi = body[1];
+            break;
+        case PM4ItOpcode::IndexBufferSize:
+            regs.num_indices = body[0];
+            break;
+        case PM4ItOpcode::ContextControl:
+            break;
+        case PM4ItOpcode::ClearState:
+            ClearState(regs);
+            ++stats.clear_states;
+            break;
+        case PM4ItOpcode::DrawIndex2:
+            regs.max_index_size = body[0];
+            regs.index_base_address.base_addr_lo = body[1];
+            regs.index_base_address.base_addr_hi = body[2];
+            regs.num_indices = body[3];
+            regs.draw_initiator = body[4];
+            ++stats.draws;
+            visitor.OnDraw(p, opcode, regs, extents);
+            break;
+        case PM4ItOpcode::DrawIndexOffset2:
+            regs.max_index_size = body[0];
+            regs.num_indices = body[2];
+            regs.draw_initiator = body[3];
+            ++stats.draws;
+            visitor.OnDraw(p, opcode, regs, extents);
+            break;
+        case PM4ItOpcode::DrawIndexAuto:
+            regs.num_indices = body[0];
+            regs.draw_initiator = body[1];
+            ++stats.draws;
+            visitor.OnDraw(p, opcode, regs, extents);
+            break;
+        case PM4ItOpcode::IndirectBuffer: {
+            const auto* ib = reinterpret_cast<const AmdGpu::PM4CmdIndirectBuffer*>(p);
+            if (ib->chain) {
+                // PGL links its command chunks: the walk continues in the next one.
+                const u32* next = ib->Address<const u32>();
+                if (!Readable(next, ib->ib_size * sizeof(u32))) {
+                    return Fail(false, "chained chunk not readable", stats);
+                }
+                ++stats.chain_links;
+                p = next;
+                limit = next + ib->ib_size;
+                NoteChunk(stats, next, limit);
+                continue;
+            }
+            ++stats.call_links; // not used by GT Sport's jobs; its commands are not followed
+            visitor.OnOther(p, opcode);
+            break;
+        }
+        default:
+            visitor.OnOther(p, opcode);
+            break;
+        }
+        p += count + 1;
+    }
+    return true;
+}
+
+void WalkJob(const JobRange& job, Regs& regs, JobExtents& extents, JobVisitor& visitor,
+             WalkStats& stats) {
+    JobCursor cursor;
+    if (cursor.Start(job.begin, job.first_limit, stats)) {
+        cursor.WalkTo(job.end, regs, extents, visitor, stats);
+    }
+}
+
+} // namespace Native
diff --git a/ryty_gpu/native/job_walker.h b/ryty_gpu/native/job_walker.h
new file mode 100644
index 00000000..182a7567
--- /dev/null
+++ b/ryty_gpu/native/job_walker.h
@@ -0,0 +1,108 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// NAT-004: reads one GT Sport render job's commands on the thread that recorded it, keeping the
+// GPU state the command processor would have at each packet. PGL links a job's command chunks
+// with chained INDIRECT_BUFFER packets (written into a 16-byte slot at the end of the previous
+// chunk when a chunk closes); the walk follows them and ends where the job's commands end.
+
+#pragma once
+
+#include <array>
+
+#include "common/types.h"
+#include "video_core/amdgpu/cb_db_extent.h"
+#include "video_core/amdgpu/pm4_opcodes.h"
+
+namespace AmdGpu {
+union Regs;
+}
+
+namespace Native {
+
+struct JobRange {
+    const u32* begin = nullptr;       ///< first chunk (the job's command buffer at its start)
+    const u32* first_limit = nullptr; ///< end of the first chunk's command space
+    const u32* end = nullptr;         ///< where the job's commands end
+};
+
+/// The render target sizes hinted by the NOP after CB/DB setups (as the command processor
+/// keeps them: the real size, smaller than pitch x height).
+struct JobExtents {
+    std::array<AmdGpu::CbDbExtent, 8> cb{};
+    AmdGpu::CbDbExtent db{};
+};
+
+class JobVisitor {
+public:
+    virtual ~JobVisitor() = default;
+    /// A draw packet, with the state at the draw (the packet's own fields applied).
+    virtual void OnDraw(const u32* packet, AmdGpu::PM4ItOpcode opcode, const AmdGpu::Regs& regs,
+                        const JobExtents& extents) = 0;
+    /// A packet that is neither state nor a draw: cache flushes, events, waits, memory writes,
+    /// dispatches. Native recording ends a segment of draws there.
+    virtual void OnOther(const u32* packet, AmdGpu::PM4ItOpcode opcode) {}
+};
+
+struct WalkStats {
+    u64 packets = 0;
+    u64 draws = 0;
+    u64 chain_links = 0;
+    u64 call_links = 0;
+    bool bad_packet = false;
+    bool overrun = false;
+    // NAT-005: where a failed walk stopped, and the chunks it went through.
+    const u32* stop = nullptr;
+    u32 stop_header = 0;
+    const char* reason = nullptr;
+    std::array<std::pair<const u32*, const u32*>, 16> chunks{}; // (begin, limit)
+    u32 num_chunks = 0;
+    u32 forks = 0;        // NAT-006: children skipped
+    u32 clear_states = 0; // CLEAR_STATE packets (registers back to their defaults)
+};
+
+/// A walk through one job's commands that stops and goes on (NAT-006). A job hands work to a child
+/// job by forking: PGL ends the job's command run with a 16-byte link slot that will lead into the
+/// child's commands, and the job's own commands go on after it (or in a fresh chunk), linked after
+/// the child's last chunk. The GPU runs the child in between, but the child is recorded on another
+/// thread and may not be finished, so the walk skips it and goes on with the job's own commands.
+class JobCursor {
+public:
+    /// Starts at the job's first chunk; false (with `stats` saying why) if it can't be read.
+    bool Start(const u32* begin, const u32* first_limit, WalkStats& stats);
+    /// Reads the job's commands up to `until` (the write pointer at a fork or at the job's end).
+    bool WalkTo(const u32* until, AmdGpu::Regs& regs, JobExtents& extents, JobVisitor& visitor,
+                WalkStats& stats);
+    /// The job forked at the point the walk reached; its commands go on at `next`, in command
+    /// space ending at `next_limit` (the command buffer's end pointer after the fork).
+    void SkipFork(const u32* next, const u32* next_limit, WalkStats& stats);
+    bool Ok() const {
+        return ok;
+    }
+    const u32* Position() const {
+        return p;
+    }
+    const u32* Limit() const {
+        return limit;
+    }
+
+private:
+    bool Fail(bool overrun, const char* reason, WalkStats& stats);
+
+    const u32* p = nullptr;
+    const u32* limit = nullptr; // the walk stays inside the chunk it is in
+    bool ok = false;
+};
+
+/// Walks the job's commands; `regs` holds the state at the start and the state at the end after.
+void WalkJob(const JobRange& job, AmdGpu::Regs& regs, JobExtents& extents, JobVisitor& visitor,
+             WalkStats& stats);
+
+/// Whether CPU code may read the range (guards the walk against bad links).
+bool Readable(const void* address, size_t size);
+/// NAT-106: how many bytes from the start of the range the CPU can read.
+u64 ReadablePrefix(const void* address, u64 size);
+/// NAT-147: memory leaves the readable cache of Readable/ReadablePrefix (it was unmapped).
+void ForgetReadable(u64 address, u64 size);
+
+} // namespace Native
diff --git a/ryty_gpu/native/native_selftest.cpp b/ryty_gpu/native/native_selftest.cpp
new file mode 100644
index 00000000..62a56ed5
--- /dev/null
+++ b/ryty_gpu/native/native_selftest.cpp
@@ -0,0 +1,179 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// NAT-021: self test of the native image registry, outside the game. For a micro-tiled, a
+// macro-tiled and a display-tiled layout with mips, a pattern is put in a render target, written
+// out in the guest's tiled layout (RecordDownload), handed back as a texture in "guest memory"
+// (RecordUploads untiles it) and compared texel by texel.
+
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+#include <fmt/format.h>
+
+#include "ryty_gpu/native/image_registry.h"
+#include "ryty_gpu/native/rhi/rhi_vulkan.h"
+#include "video_core/amdgpu/tiling.h"
+
+namespace {
+
+using namespace Native;
+
+VideoCore::ImageInfo MakeInfo(AmdGpu::TileMode tile_mode, u32 width, u32 height, u32 mips,
+                              VAddr address) {
+    VideoCore::ImageInfo info{};
+    info.props = {};
+    info.props.is_tiled = tile_mode != AmdGpu::TileMode::DisplayLinearAligned;
+    info.props.is_pow2 = std::has_single_bit(width) && std::has_single_bit(height);
+    info.tile_mode = tile_mode;
+    info.array_mode = AmdGpu::GetArrayMode(tile_mode);
+    info.pixel_format = vk::Format::eR8G8B8A8Unorm;
+    info.num_samples = 1;
+    info.num_bits = 32;
+    info.type = AmdGpu::ImageType::Color2D;
+    info.size = {width, height, 1};
+    info.pitch = width;
+    info.resources = {static_cast<u16>(mips), 1};
+    info.guest_address = address;
+    info.UpdateSize();
+    return info;
+}
+
+u32 Texel(u32 x, u32 y, u32 mip) {
+    return x | (y << 10) | (mip << 20) | 0xA0000000u;
+}
+
+bool RunCase(Rhi::Device& device, ImageRegistry& registry, Rhi::Fence& fence, u64& tick,
+             AmdGpu::TileMode tile_mode, std::string& log) {
+    constexpr u32 kWidth = 256, kHeight = 256, kMips = 4;
+    const auto name = AmdGpu::NameOf(tile_mode);
+    // 1. A render target filled with the pattern from a linear buffer.
+    const VAddr target_address = 0x7000'0000'0000ULL + (u64(tile_mode) << 24);
+    const auto target_info = MakeInfo(tile_mode, kWidth, kHeight, kMips, target_address);
+    const u64 size = target_info.guest_size;
+    ImageEntry* target = registry.Find(target_info, true, 1);
+    auto pattern = device.CreateBuffer({.size = size,
+                                        .usage = Rhi::BufferUsageTransferSrc,
+                                        .memory = Rhi::MemoryKind::Upload});
+    auto tiled = device.CreateBuffer({.size = size,
+                                      .usage = Rhi::BufferUsageStorage | Rhi::BufferUsageTransferDst,
+                                      .memory = Rhi::MemoryKind::Readback});
+    if (!target || !pattern || !tiled) {
+        log += fmt::format("{}: setup failed\n", name);
+        return false;
+    }
+    std::memset(pattern->Mapped(), 0, size);
+    for (u32 m = 0; m < kMips; ++m) {
+        const auto& mip = target_info.mips_layout[m];
+        const u32 width = std::max(kWidth >> m, 1u), height = std::max(kHeight >> m, 1u);
+        for (u32 y = 0; y < height; ++y) {
+            for (u32 x = 0; x < width; ++x) {
+                const u32 value = Texel(x, y, m);
+                std::memcpy(pattern->Mapped() + mip.offset + (u64(y) * mip.pitch + x) * 4, &value, 4);
+            }
+        }
+    }
+    Rhi::CommandList* list = device.AcquireCommandList();
+    list->Begin();
+    list->CopyBufferToImage(pattern.get(), target->image.get(), MipCopies(target_info));
+    list->Barrier(Rhi::ScopeTransfer, Rhi::ScopeTransfer);
+    if (!registry.RecordDownload(*list, *target, *tiled)) {
+        log += fmt::format("{}: download not recorded\n", name);
+        return false;
+    }
+    list->Barrier(Rhi::ScopeTransfer | Rhi::ScopeCompute, Rhi::ScopeHost);
+    list->End();
+    Rhi::CommandList* lists[] = {list};
+    device.GraphicsQueue().Submit(lists, {}, {&fence, ++tick});
+    if (!fence.Wait(tick, 5'000'000'000ULL)) {
+        log += fmt::format("{}: download did not finish\n", name);
+        return false;
+    }
+    // 2. The tiled bytes as guest memory, found as a texture and untiled by the upload.
+    std::vector<u8> guest(size + 4096);
+    u8* guest_memory = reinterpret_cast<u8*>((reinterpret_cast<uintptr_t>(guest.data()) + 4095) & ~uintptr_t{4095});
+    std::memcpy(guest_memory, tiled->Mapped(), size);
+    const auto texture_info =
+        MakeInfo(tile_mode, kWidth, kHeight, kMips, reinterpret_cast<VAddr>(guest_memory));
+    ImageEntry* texture = registry.Find(texture_info, false, 2);
+    auto readback = device.CreateBuffer({.size = size,
+                                         .usage = Rhi::BufferUsageTransferDst,
+                                         .memory = Rhi::MemoryKind::Readback});
+    if (!texture || !readback) {
+        log += fmt::format("{}: texture setup failed\n", name);
+        return false;
+    }
+    std::memset(readback->Mapped(), 0, size);
+    list = device.AcquireCommandList();
+    list->Begin();
+    const u32 uploads = registry.RecordUploads(*list);
+    list->CopyImageToBuffer(texture->image.get(), readback.get(), MipCopies(texture_info));
+    list->Barrier(Rhi::ScopeTransfer, Rhi::ScopeHost);
+    list->End();
+    lists[0] = list;
+    device.GraphicsQueue().Submit(lists, {}, {&fence, ++tick});
+    if (!fence.Wait(tick, 5'000'000'000ULL)) {
+        log += fmt::format("{}: upload did not finish\n", name);
+        return false;
+    }
+    u64 wrong = 0, total = 0;
+    for (u32 m = 0; m < kMips; ++m) {
+        const auto& mip = texture_info.mips_layout[m];
+        const u32 width = std::max(kWidth >> m, 1u), height = std::max(kHeight >> m, 1u);
+        for (u32 y = 0; y < height; ++y) {
+            for (u32 x = 0; x < width; ++x) {
+                u32 value;
+                std::memcpy(&value, readback->Mapped() + mip.offset + (u64(y) * mip.pitch + x) * 4, 4);
+                wrong += value != Texel(x, y, m);
+                ++total;
+            }
+        }
+    }
+    // The tiled bytes must differ from the linear ones (otherwise nothing was tiled).
+    const bool changed = std::memcmp(tiled->Mapped(), pattern->Mapped(), size) != 0;
+    log += fmt::format("{}: {} uploaded, guest size {} bytes, tiled layout {}, {} of {} texels {}\n",
+                       name, uploads, size, changed ? "differs from linear" : "SAME AS LINEAR",
+                       total - wrong, total, wrong == 0 ? "correct" : "WRONG");
+    return wrong == 0 && uploads == 1 && changed;
+}
+
+bool RunImageSelfTest(std::string& log) {
+    std::string error;
+    auto device = Rhi::CreateStandaloneVulkanDevice(&error);
+    if (!device) {
+        log += "no device: " + error + "\n";
+        return false;
+    }
+    auto fence = device->CreateFence(0);
+    u64 tick = 0;
+    bool ok = true;
+    {
+        ImageRegistry registry{*device};
+        for (const auto mode : {AmdGpu::TileMode::Thin1DThin, AmdGpu::TileMode::Thin2DThin,
+                                AmdGpu::TileMode::Display2DThin}) {
+            ok = RunCase(*device, registry, *fence, tick, mode, log) && ok;
+        }
+        const auto& stats = registry.GetStats();
+        log += fmt::format("registry: {} lookups, {} textures, {} render targets, {} uploads\n",
+                           stats.lookups.load(), stats.created_textures.load(),
+                           stats.created_targets.load(), stats.uploads.load());
+    }
+    std::ignore = fence->Wait(tick, 5'000'000'000ULL);
+    device->Collect();
+    return ok;
+}
+
+} // namespace
+
+extern "C" __declspec(dllexport) int RytyNativeImageSelfTest(char* report, int report_size) {
+    std::string log;
+    const bool ok = RunImageSelfTest(log);
+    log += ok ? "NAT-021 image self test passed\n" : "NAT-021 image self test FAILED\n";
+    if (report && report_size > 0) {
+        const size_t n = std::min<size_t>(log.size(), static_cast<size_t>(report_size) - 1);
+        std::memcpy(report, log.data(), n);
+        report[n] = '\0';
+    }
+    return ok ? 0 : 1;
+}
diff --git a/ryty_gpu/native/rhi/rhi.h b/ryty_gpu/native/rhi/rhi.h
new file mode 100644
index 00000000..a4a1cc2c
--- /dev/null
+++ b/ryty_gpu/native/rhi/rhi.h
@@ -0,0 +1,553 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// NAT-010: the native renderer's backend interface (RHI). The renderer records through it and
+// never touches Vulkan or Direct3D 12 itself, so a second backend is a second implementation of
+// these classes. It is shaped by what GT Sport's draws need:
+// - command lists are recorded by many threads at once (one per render job) and submitted in
+//   the GPU order the game chose;
+// - resources are bound per draw: one set of descriptors pushed with the draw (Vulkan push
+//   descriptors; D3D12 a descriptor table copied into a ring) plus push constants;
+// - images stay in one general layout; synchronisation is global memory barriers placed where
+//   the game flushes caches, as on the PS4;
+// - guest memory can be imported as a buffer, so shaders read the game's buffers in place.
+
+#pragma once
+
+#include <array>
+#include <functional>
+#include <memory>
+#include <span>
+#include <string_view>
+
+#include "common/types.h"
+
+namespace Native::Rhi {
+
+enum class BackendKind : u8 { Vulkan, D3D12 };
+
+/// Formats use Vulkan's numbering (VkFormat), which the GCN translation already produces; the
+/// D3D12 backend maps them to DXGI formats.
+enum class Format : u32 { Undefined = 0 };
+constexpr Format FormatFromVk(u32 vk_format) {
+    return static_cast<Format>(vk_format);
+}
+
+enum class MemoryKind : u8 {
+    DeviceLocal, ///< GPU-only
+    Upload,      ///< CPU-written each frame, persistently mapped
+    Readback,    ///< GPU-written, read by the CPU
+};
+
+enum BufferUsage : u32 {
+    BufferUsageNone = 0,
+    BufferUsageVertex = 1 << 0,
+    BufferUsageIndex = 1 << 1,
+    BufferUsageUniform = 1 << 2,
+    BufferUsageStorage = 1 << 3,
+    BufferUsageTexel = 1 << 4,      ///< uniform/storage texel buffers
+    BufferUsageIndirect = 1 << 5,
+    BufferUsageTransferSrc = 1 << 6,
+    BufferUsageTransferDst = 1 << 7,
+    BufferUsageDeviceAddress = 1 << 8,
+};
+
+struct BufferDesc {
+    u64 size = 0;
+    u32 usage = BufferUsageNone;
+    MemoryKind memory = MemoryKind::DeviceLocal;
+    std::string_view name;
+};
+
+enum class ImageDim : u8 { D1, D2, D3 };
+
+enum ImageUsage : u32 {
+    ImageUsageNone = 0,
+    ImageUsageSampled = 1 << 0,
+    ImageUsageStorage = 1 << 1,
+    ImageUsageColorTarget = 1 << 2,
+    ImageUsageDepthTarget = 1 << 3,
+    ImageUsageTransferSrc = 1 << 4,
+    ImageUsageTransferDst = 1 << 5,
+    ImageUsageCube = 1 << 6,          ///< array layers can be viewed as cube faces
+    ImageUsageMutableFormat = 1 << 7, ///< views may use other formats of the same size
+};
+
+struct ImageDesc {
+    ImageDim dim = ImageDim::D2;
+    Format format = Format::Undefined;
+    u32 width = 1;
+    u32 height = 1;
+    u32 depth = 1;
+    u32 layers = 1;
+    u32 mips = 1;
+    u32 samples = 1;
+    u32 usage = ImageUsageNone;
+    std::string_view name;
+};
+
+enum class ViewDim : u8 { D1, D1Array, D2, D2Array, D3, Cube, CubeArray };
+enum class Swizzle : u8 { Identity, Zero, One, R, G, B, A };
+enum ImageAspect : u8 { AspectColor = 1, AspectDepth = 2, AspectStencil = 4 };
+
+struct ImageViewDesc {
+    ViewDim dim = ViewDim::D2;
+    Format format = Format::Undefined; ///< Undefined: the image's format
+    u32 base_mip = 0;
+    u32 mips = 1;
+    u32 base_layer = 0;
+    u32 layers = 1;
+    u8 aspect = AspectColor;
+    std::array<Swizzle, 4> swizzle{};
+    bool storage = false; ///< for storage-image access instead of sampling
+};
+
+enum class Filter : u8 { Nearest, Linear };
+enum class AddressMode : u8 { Repeat, MirroredRepeat, ClampToEdge, ClampToBorder, MirrorClampToEdge };
+enum class CompareOp : u8 { Never, Less, Equal, LessOrEqual, Greater, NotEqual, GreaterOrEqual, Always };
+enum class BorderColor : u8 { TransparentBlack, OpaqueBlack, OpaqueWhite };
+
+struct SamplerDesc {
+    Filter min_filter = Filter::Linear;
+    Filter mag_filter = Filter::Linear;
+    Filter mip_filter = Filter::Linear;
+    std::array<AddressMode, 3> address{AddressMode::Repeat, AddressMode::Repeat, AddressMode::Repeat};
+    float mip_lod_bias = 0.0f;
+    float min_lod = 0.0f;
+    float max_lod = 1000.0f;
+    float max_anisotropy = 1.0f; ///< 1: off
+    bool compare = false;
+    CompareOp compare_op = CompareOp::Never;
+    BorderColor border = BorderColor::TransparentBlack;
+};
+
+class Buffer {
+public:
+    virtual ~Buffer() = default;
+    virtual u64 Size() const = 0;
+    /// The buffer's GPU virtual address (Vulkan buffer device address / D3D12 GPU VA).
+    virtual u64 GpuAddress() const = 0;
+    /// CPU pointer of Upload/Readback memory; nullptr for device-local memory.
+    virtual u8* Mapped() const = 0;
+    /// The backend's own object (Vulkan: VkBuffer), for recording outside this interface.
+    virtual u64 NativeHandle() const = 0;
+};
+
+class Image {
+public:
+    virtual ~Image() = default;
+    virtual const ImageDesc& Desc() const = 0;
+    /// The backend's own object (Vulkan: VkImage).
+    virtual u64 NativeHandle() const = 0;
+};
+
+class ImageView {
+public:
+    virtual ~ImageView() = default;
+    /// The backend's own object (Vulkan: VkImageView).
+    virtual u64 NativeHandle() const = 0;
+};
+
+class Sampler {
+public:
+    virtual ~Sampler() = default;
+    /// The backend's own object (Vulkan: VkSampler).
+    virtual u64 NativeHandle() const = 0;
+};
+
+enum class ShaderStage : u8 { Vertex, Hull, Domain, Geometry, Pixel, Compute };
+enum StageMask : u32 {
+    StageVertex = 1 << 0,
+    StageHull = 1 << 1,
+    StageDomain = 1 << 2,
+    StageGeometry = 1 << 3,
+    StagePixel = 1 << 4,
+    StageCompute = 1 << 5,
+    StageAllGraphics = 0x1f,
+};
+
+/// A specialization constant (SPIR-V constant_id).
+struct SpecConstant {
+    u32 id = 0;
+    u32 value = 0;
+};
+
+struct ShaderCode {
+    ShaderStage stage = ShaderStage::Vertex;
+    std::span<const u32> spirv; ///< D3D12 converts it to DXIL
+    std::string_view entry = "main";
+    std::span<const SpecConstant> constants;
+};
+
+enum class BindingType : u8 {
+    UniformBuffer,
+    StorageBuffer,
+    SampledImage,
+    StorageImage,
+    Sampler,
+    UniformTexelBuffer,
+    StorageTexelBuffer,
+};
+
+/// One binding of the per-draw descriptor set (Vulkan: set 0, binding `slot`).
+struct BindingSlot {
+    u32 slot = 0;
+    BindingType type = BindingType::UniformBuffer;
+    u32 stages = StageAllGraphics;
+};
+
+struct PipelineLayoutDesc {
+    std::span<const BindingSlot> bindings;
+    u32 push_constant_bytes = 0;
+    u32 push_constant_stages = StageAllGraphics;
+};
+
+class PipelineLayout {
+public:
+    virtual ~PipelineLayout() = default;
+};
+
+enum class Topology : u8 {
+    PointList,
+    LineList,
+    LineStrip,
+    TriangleList,
+    TriangleStrip,
+    TriangleFan,
+    PatchList,
+};
+enum class CullMode : u8 { None, Front, Back, FrontAndBack };
+enum class FillMode : u8 { Solid, Wireframe, Point };
+enum class BlendFactor : u8 {
+    Zero, One, SrcColor, OneMinusSrcColor, DstColor, OneMinusDstColor, SrcAlpha,
+    OneMinusSrcAlpha, DstAlpha, OneMinusDstAlpha, ConstantColor, OneMinusConstantColor,
+    ConstantAlpha, OneMinusConstantAlpha, SrcAlphaSaturate, Src1Color, OneMinusSrc1Color,
+    Src1Alpha, OneMinusSrc1Alpha,
+};
+enum class BlendOp : u8 { Add, Subtract, ReverseSubtract, Min, Max };
+enum class StencilOp : u8 { Keep, Zero, Replace, IncrementClamp, DecrementClamp, Invert, IncrementWrap, DecrementWrap };
+
+struct BlendTarget {
+    bool enable = false;
+    BlendFactor src_color = BlendFactor::One;
+    BlendFactor dst_color = BlendFactor::Zero;
+    BlendOp color_op = BlendOp::Add;
+    BlendFactor src_alpha = BlendFactor::One;
+    BlendFactor dst_alpha = BlendFactor::Zero;
+    BlendOp alpha_op = BlendOp::Add;
+    u8 write_mask = 0xf;
+};
+
+struct StencilFace {
+    StencilOp fail = StencilOp::Keep;
+    StencilOp depth_fail = StencilOp::Keep;
+    StencilOp pass = StencilOp::Keep;
+    CompareOp compare = CompareOp::Always;
+};
+
+struct VertexAttribute {
+    u32 location = 0;
+    u32 binding = 0;
+    Format format = Format::Undefined;
+    u32 offset = 0;
+};
+struct VertexBinding {
+    u32 binding = 0;
+    u32 stride = 0;
+    bool per_instance = false;
+    u32 divisor = 1;
+};
+
+constexpr u32 kMaxColorTargets = 8;
+
+struct GraphicsPipelineDesc {
+    PipelineLayout* layout = nullptr;
+    std::span<const ShaderCode> shaders;
+    std::span<const VertexBinding> vertex_bindings;
+    std::span<const VertexAttribute> vertex_attributes;
+    Topology topology = Topology::TriangleList;
+    u32 patch_control_points = 0;
+    bool primitive_restart = false;
+    // Rasterizer
+    CullMode cull = CullMode::None;
+    bool front_counter_clockwise = false;
+    FillMode fill = FillMode::Solid;
+    bool depth_clamp = false;
+    bool depth_clip = true;
+    bool depth_bias = false;
+    bool rasterizer_discard = false;
+    u32 samples = 1;
+    bool alpha_to_coverage = false;
+    // Depth / stencil
+    bool depth_test = false;
+    bool depth_write = false;
+    CompareOp depth_compare = CompareOp::Always;
+    bool depth_bounds_test = false;
+    bool stencil_test = false;
+    StencilFace stencil_front{};
+    StencilFace stencil_back{};
+    // Colour
+    u32 color_count = 0;
+    std::array<Format, kMaxColorTargets> color_formats{};
+    std::array<BlendTarget, kMaxColorTargets> blend{};
+    bool logic_op_enable = false;
+    u8 logic_op = 0;
+    Format depth_format = Format::Undefined;
+    Format stencil_format = Format::Undefined;
+    /// Cull mode, front face, depth and stencil tests, depth bias enable and primitive restart
+    /// come from SetRasterState / SetDepthStencilState instead of the fields above, so fewer
+    /// pipelines are needed (Caps().dynamic_raster_depth_stencil; D3D12 bakes them in).
+    bool dynamic_raster_depth_stencil = false;
+    std::string_view name;
+};
+
+struct ComputePipelineDesc {
+    PipelineLayout* layout = nullptr;
+    ShaderCode shader{};
+    std::string_view name;
+};
+
+class Pipeline {
+public:
+    virtual ~Pipeline() = default;
+};
+
+/// One resource for the per-draw descriptor set.
+struct Binding {
+    u32 slot = 0;
+    BindingType type = BindingType::UniformBuffer;
+    const Buffer* buffer = nullptr;
+    u64 offset = 0;
+    u64 size = 0;
+    Format texel_format = Format::Undefined; ///< texel buffers
+    const ImageView* view = nullptr;
+    const Sampler* sampler = nullptr;
+};
+
+enum class LoadOp : u8 { Load, Clear, DontCare };
+enum class StoreOp : u8 { Store, DontCare };
+
+struct ColorAttachment {
+    const ImageView* view = nullptr;
+    LoadOp load = LoadOp::Load;
+    StoreOp store = StoreOp::Store;
+    std::array<float, 4> clear{};
+};
+struct DepthAttachment {
+    const ImageView* view = nullptr;
+    LoadOp depth_load = LoadOp::Load;
+    StoreOp depth_store = StoreOp::Store;
+    LoadOp stencil_load = LoadOp::Load;
+    StoreOp stencil_store = StoreOp::Store;
+    float clear_depth = 1.0f;
+    u8 clear_stencil = 0;
+    bool read_only = false;
+};
+struct RenderingDesc {
+    u32 width = 0;
+    u32 height = 0;
+    u32 layers = 1;
+    u32 color_count = 0;
+    std::array<ColorAttachment, kMaxColorTargets> colors{};
+    DepthAttachment depth{};
+};
+
+struct Viewport {
+    float x = 0, y = 0, width = 0, height = 0, min_depth = 0, max_depth = 1;
+};
+struct Rect {
+    s32 x = 0, y = 0;
+    u32 width = 0, height = 0;
+};
+
+enum class IndexType : u8 { U16, U32 };
+
+/// Pipeline state set while recording, for pipelines made with dynamic_raster_depth_stencil.
+struct DynamicRasterState {
+    CullMode cull = CullMode::None;
+    bool front_counter_clockwise = false;
+    bool depth_bias = false;
+    bool primitive_restart = false;
+    bool rasterizer_discard = false;
+};
+struct DynamicDepthStencilState {
+    bool depth_test = false;
+    bool depth_write = false;
+    CompareOp depth_compare = CompareOp::Always;
+    bool depth_bounds_test = false;
+    bool stencil_test = false;
+    StencilFace stencil_front{};
+    StencilFace stencil_back{};
+};
+
+enum class CommandListLevel : u8 {
+    Primary,   ///< submitted with Queue::Submit
+    Secondary, ///< run inside another API's command buffer (see NativeHandle, MarkExecuted)
+};
+
+/// What a barrier waits for and what it holds back (global: all resources).
+enum BarrierScope : u32 {
+    ScopeNone = 0,
+    ScopeDraw = 1 << 0,     ///< vertex .. colour/depth output of draws
+    ScopeCompute = 1 << 1,  ///< compute shaders
+    ScopeTransfer = 1 << 2, ///< copies and clears
+    ScopeHost = 1 << 3,     ///< CPU access of mapped memory
+    ScopeAll = 0xf,
+};
+
+struct BufferImageCopy {
+    u64 buffer_offset = 0;
+    u32 buffer_row_texels = 0; ///< 0: tightly packed
+    u32 buffer_image_rows = 0;
+    u32 mip = 0;
+    u32 base_layer = 0;
+    u32 layers = 1;
+    std::array<s32, 3> offset{};
+    std::array<u32, 3> extent{1, 1, 1};
+    u8 aspect = AspectColor;
+};
+
+/// A list of GPU commands, recorded by one thread at a time.
+class CommandList {
+public:
+    virtual ~CommandList() = default;
+
+    virtual void Begin() = 0;
+    virtual void End() = 0;
+
+    virtual void BeginRendering(const RenderingDesc& desc) = 0;
+    virtual void EndRendering() = 0;
+
+    virtual void SetViewports(std::span<const Viewport> viewports) = 0;
+    virtual void SetScissors(std::span<const Rect> scissors) = 0;
+    virtual void SetBlendConstants(const std::array<float, 4>& constants) = 0;
+    virtual void SetStencilReference(u8 front, u8 back) = 0;
+    virtual void SetStencilMasks(u8 compare_front, u8 compare_back, u8 write_front, u8 write_back) = 0;
+    virtual void SetDepthBias(float constant, float clamp, float slope) = 0;
+    virtual void SetDepthBounds(float min, float max) = 0;
+    virtual void SetLineWidth(float width) = 0;
+
+    virtual void SetRasterState(const DynamicRasterState& state) = 0;
+    virtual void SetDepthStencilState(const DynamicDepthStencilState& state) = 0;
+
+    virtual void BindPipeline(const Pipeline* pipeline) = 0;
+    /// The per-draw descriptor set of the bound pipeline's layout.
+    virtual void PushBindings(std::span<const Binding> bindings) = 0;
+    virtual void PushConstants(u32 offset, std::span<const u8> data) = 0;
+    virtual void BindVertexBuffers(u32 first, std::span<const Buffer* const> buffers,
+                                   std::span<const u64> offsets) = 0;
+    virtual void BindIndexBuffer(const Buffer* buffer, u64 offset, IndexType type) = 0;
+
+    virtual void Draw(u32 vertices, u32 instances, u32 first_vertex, u32 first_instance) = 0;
+    virtual void DrawIndexed(u32 indices, u32 instances, u32 first_index, s32 vertex_offset,
+                             u32 first_instance) = 0;
+    virtual void Dispatch(u32 x, u32 y, u32 z) = 0;
+
+    virtual void Barrier(u32 wait_for, u32 hold_back) = 0;
+    virtual void CopyBuffer(const Buffer* src, u64 src_offset, const Buffer* dst, u64 dst_offset,
+                            u64 size) = 0;
+    virtual void CopyBufferToImage(const Buffer* src, const Image* dst,
+                                   std::span<const BufferImageCopy> regions) = 0;
+    virtual void CopyImageToBuffer(const Image* src, const Buffer* dst,
+                                   std::span<const BufferImageCopy> regions) = 0;
+    virtual void FillBuffer(const Buffer* dst, u64 offset, u64 size, u32 value) = 0;
+    virtual void ClearColorImage(const Image* image, const std::array<float, 4>& color) = 0;
+
+    virtual void BeginMarker(std::string_view name) = 0;
+    virtual void EndMarker() = 0;
+
+    /// Runs secondary lists (Caps().secondary_lists) here, outside any rendering.
+    virtual void ExecuteSecondary(std::span<CommandList* const> lists) = 0;
+
+    /// The backend's own object (Vulkan: VkCommandBuffer), for running a secondary list inside
+    /// a command buffer the renderer records elsewhere.
+    virtual u64 NativeHandle() const = 0;
+};
+
+/// A GPU timeline: Signal from a submission, wait from the CPU or another submission.
+class Fence {
+public:
+    virtual ~Fence() = default;
+    virtual u64 Completed() const = 0;
+    /// Waits until the fence reaches `value` or `timeout_ns` passes; true when reached.
+    virtual bool Wait(u64 value, u64 timeout_ns) const = 0;
+};
+
+struct FenceValue {
+    Fence* fence = nullptr;
+    u64 value = 0;
+};
+
+class Queue {
+public:
+    virtual ~Queue() = default;
+    /// Runs the lists in order after `waits`, then signals `signal`.
+    virtual void Submit(std::span<CommandList* const> lists, std::span<const FenceValue> waits,
+                        FenceValue signal) = 0;
+};
+
+/// What the device can do, for choices the renderer makes.
+struct DeviceCaps {
+    BackendKind backend = BackendKind::Vulkan;
+    bool import_host_memory = false; ///< guest memory as a buffer
+    u64 host_import_alignment = 0;
+    bool geometry_shaders = false;
+    bool tessellation = false;
+    bool depth_bounds = false;
+    bool depth_clip_control = false;
+    bool dynamic_raster_depth_stencil = false;
+    bool secondary_lists = false; ///< CommandListLevel::Secondary and ExecuteSecondary
+    u32 max_push_constant_bytes = 128;
+    u32 max_push_bindings = 0; ///< more per-draw bindings than this use a descriptor set per draw
+};
+
+class Device {
+public:
+    virtual ~Device() = default;
+    virtual const DeviceCaps& Caps() const = 0;
+
+    virtual std::unique_ptr<Buffer> CreateBuffer(const BufferDesc& desc) = 0;
+    /// Wraps existing CPU memory (page aligned, `Caps().host_import_alignment`) as a buffer the
+    /// GPU reads and writes in place; nullptr when unsupported.
+    /// NAT-107: a buffer made elsewhere (Vulkan: a VkBuffer), not owned: bound and copied
+    /// like the others, never destroyed by this object.
+    virtual std::unique_ptr<Buffer> WrapBuffer(u64 native_handle, u64 size) = 0;
+    virtual std::unique_ptr<Buffer> ImportHostMemory(void* memory, u64 size, u32 usage,
+                                                     std::string_view name) = 0;
+    virtual std::unique_ptr<Image> CreateImage(const ImageDesc& desc) = 0;
+    virtual std::unique_ptr<ImageView> CreateImageView(const Image* image,
+                                                       const ImageViewDesc& desc) = 0;
+    virtual std::unique_ptr<Sampler> CreateSampler(const SamplerDesc& desc) = 0;
+    virtual std::unique_ptr<PipelineLayout> CreatePipelineLayout(const PipelineLayoutDesc& desc) = 0;
+    /// May run on any thread; nullptr when the driver refuses the pipeline.
+    virtual std::unique_ptr<Pipeline> CreateGraphicsPipeline(const GraphicsPipelineDesc& desc) = 0;
+    virtual std::unique_ptr<Pipeline> CreateComputePipeline(const ComputePipelineDesc& desc) = 0;
+    virtual std::unique_ptr<Fence> CreateFence(u64 initial) = 0;
+    /// A timeline created elsewhere (Vulkan: a timeline VkSemaphore), not owned.
+    virtual std::unique_ptr<Fence> ImportFence(u64 native_handle) = 0;
+
+    /// A command list from the calling thread's pool, ready for Begin. A list goes back to its
+    /// pool once the GPU has run the submission it was part of (or when Release is called on a
+    /// list that was never submitted).
+    virtual CommandList* AcquireCommandList(CommandListLevel level = CommandListLevel::Primary) = 0;
+    virtual void ReleaseUnsubmitted(CommandList* list) = 0;
+    /// A list run by someone else's submission (a secondary list) goes back to its pool once
+    /// `retire` is reached.
+    virtual void MarkExecuted(CommandList* list, FenceValue retire) = 0;
+    virtual Queue& GraphicsQueue() = 0;
+
+    /// Recycles command lists and frees objects the GPU has finished with.
+    virtual void Collect() = 0;
+
+    /// For lists another renderer submits (secondary lists run in its command buffers): GPU
+    /// progress is read from `fence`, and `current` gives the value the work recorded now will
+    /// signal. Deferred destruction then follows that timeline instead of Queue::Submit's.
+    virtual void UseExternalTimeline(Fence* fence, std::function<u64()> current) = 0;
+    /// Records the first layout change of the images created since the last call (Queue::Submit
+    /// does it on its own); for lists another renderer runs, before any list using the images.
+    virtual void RecordPendingImageInit(CommandList& list) = 0;
+    /// Whether images were created since the last RecordPendingImageInit.
+    virtual bool PendingImageInit() = 0;
+};
+
+} // namespace Native::Rhi
diff --git a/ryty_gpu/native/rhi/rhi_selftest.cpp b/ryty_gpu/native/rhi/rhi_selftest.cpp
new file mode 100644
index 00000000..59bab646
--- /dev/null
+++ b/ryty_gpu/native/rhi/rhi_selftest.cpp
@@ -0,0 +1,417 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// NAT-012: self test of the native renderer's backend, outside the game. A test harness loads the
+// renderer library and calls RytyNativeRhiSelfTest; it creates its own Vulkan device, uploads a
+// texture, draws it with a pipeline built through the backend interface (also from four threads
+// recording their own command lists at once) and reads the picture back.
+
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+#include <fmt/format.h>
+
+#include "ryty_gpu/native/rhi/rhi.h"
+#include "ryty_gpu/native/rhi/rhi_vulkan.h"
+#include "video_core/host_shaders/fs_tri_vert.h"
+#include "video_core/host_shaders/native_test_comp.h"
+#include "video_core/host_shaders/native_test_frag.h"
+
+namespace {
+
+using namespace Native::Rhi;
+
+constexpr u32 kVkFormatR8G8B8A8Unorm = 37;
+constexpr u32 kSize = 64;
+
+struct Rgba {
+    u8 r, g, b, a;
+    bool operator==(const Rgba&) const = default;
+};
+
+bool RunSelfTest(std::string& log) {
+    std::string error;
+    auto device = CreateStandaloneVulkanDevice(&error);
+    if (!device) {
+        log += "no device: " + error + "\n";
+        return false;
+    }
+    const DeviceCaps& caps = device->Caps();
+    log += fmt::format("device: host import {} (alignment {}), push constants {} bytes, push "
+                       "descriptors {}\n",
+                       caps.import_host_memory, caps.host_import_alignment,
+                       caps.max_push_constant_bytes, caps.max_push_bindings);
+
+    // A 4x4 texture in four 2x2 colours: red, green / blue, white.
+    const std::array<Rgba, 4> quadrant{{{255, 0, 0, 255}, {0, 255, 0, 255}, {0, 0, 255, 255},
+                                        {255, 255, 255, 255}}};
+    auto upload = device->CreateBuffer({.size = 4 * 4 * 4,
+                                        .usage = BufferUsageTransferSrc,
+                                        .memory = MemoryKind::Upload});
+    auto readback = device->CreateBuffer({.size = kSize * kSize * 4,
+                                          .usage = BufferUsageTransferDst,
+                                          .memory = MemoryKind::Readback});
+    if (!upload || !readback || !upload->Mapped() || !readback->Mapped()) {
+        log += "buffers failed\n";
+        return false;
+    }
+    for (u32 y = 0; y < 4; ++y) {
+        for (u32 x = 0; x < 4; ++x) {
+            const Rgba c = quadrant[(y / 2) * 2 + x / 2];
+            std::memcpy(upload->Mapped() + (y * 4 + x) * 4, &c, 4);
+        }
+    }
+    auto texture = device->CreateImage({.format = FormatFromVk(kVkFormatR8G8B8A8Unorm),
+                                        .width = 4,
+                                        .height = 4,
+                                        .usage = ImageUsageSampled | ImageUsageTransferDst});
+    auto target = device->CreateImage({.format = FormatFromVk(kVkFormatR8G8B8A8Unorm),
+                                       .width = kSize,
+                                       .height = kSize,
+                                       .usage = ImageUsageColorTarget | ImageUsageTransferSrc});
+    if (!texture || !target) {
+        log += "images failed\n";
+        return false;
+    }
+    auto texture_view = device->CreateImageView(texture.get(), {});
+    auto target_view = device->CreateImageView(target.get(), {});
+    auto sampler = device->CreateSampler({.min_filter = Filter::Nearest,
+                                          .mag_filter = Filter::Nearest,
+                                          .mip_filter = Filter::Nearest,
+                                          .address = {AddressMode::ClampToEdge,
+                                                      AddressMode::ClampToEdge,
+                                                      AddressMode::ClampToEdge}});
+    const std::array<BindingSlot, 2> slots{{{0, BindingType::SampledImage, StagePixel},
+                                            {1, BindingType::Sampler, StagePixel}}};
+    auto layout = device->CreatePipelineLayout(
+        {.bindings = slots, .push_constant_bytes = 16, .push_constant_stages = StagePixel});
+    if (!texture_view || !target_view || !sampler || !layout) {
+        log += "views, sampler or layout failed\n";
+        return false;
+    }
+    const std::array<ShaderCode, 2> shaders{{
+        {ShaderStage::Vertex, std::span<const u32>{FS_TRI_VERT}},
+        {ShaderStage::Pixel, std::span<const u32>{NATIVE_TEST_FRAG}},
+    }};
+    GraphicsPipelineDesc pipeline_desc{.layout = layout.get(), .shaders = shaders, .color_count = 1};
+    pipeline_desc.color_formats[0] = FormatFromVk(kVkFormatR8G8B8A8Unorm);
+    auto pipeline = device->CreateGraphicsPipeline(pipeline_desc);
+    if (!pipeline) {
+        log += "pipeline failed\n";
+        return false;
+    }
+    auto fence = device->CreateFence(0);
+
+    const std::array<Binding, 2> bindings{{
+        {.slot = 0, .type = BindingType::SampledImage, .view = texture_view.get()},
+        {.slot = 1, .type = BindingType::Sampler, .sampler = sampler.get()},
+    }};
+    const auto draw = [&](CommandList* list, Rect scissor, std::array<float, 4> tint, bool clear) {
+        RenderingDesc rendering{.width = kSize, .height = kSize, .color_count = 1};
+        rendering.colors[0] = {.view = target_view.get(),
+                               .load = clear ? LoadOp::Clear : LoadOp::Load,
+                               .clear = {0, 0, 0, 0}};
+        list->BeginRendering(rendering);
+        const Viewport viewport{0, 0, float(kSize), float(kSize), 0, 1};
+        list->SetViewports({&viewport, 1});
+        list->SetScissors({&scissor, 1});
+        list->BindPipeline(pipeline.get());
+        list->PushBindings(bindings);
+        list->PushConstants(0, {reinterpret_cast<const u8*>(tint.data()), sizeof(tint)});
+        list->Draw(3, 1, 0, 0);
+        list->EndRendering();
+    };
+    const BufferImageCopy whole_texture{.extent = {4, 4, 1}};
+    const BufferImageCopy whole_target{.extent = {kSize, kSize, 1}};
+    const auto read = [&](u32 x, u32 y) {
+        Rgba c;
+        std::memcpy(&c, readback->Mapped() + (y * kSize + x) * 4, 4);
+        return c;
+    };
+    bool ok = true;
+    const auto expect = [&](const char* what, u32 x, u32 y, Rgba want) {
+        const Rgba got = read(x, y);
+        if (!(got == want)) {
+            ok = false;
+            log += fmt::format("{}: pixel {},{} is {},{},{},{}, expected {},{},{},{}\n", what, x, y,
+                               got.r, got.g, got.b, got.a, want.r, want.g, want.b, want.a);
+        }
+    };
+
+    // 1. One list: upload, draw the whole target, read back.
+    {
+        CommandList* list = device->AcquireCommandList();
+        list->Begin();
+        list->CopyBufferToImage(upload.get(), texture.get(), {&whole_texture, 1});
+        list->Barrier(ScopeTransfer, ScopeDraw);
+        draw(list, {0, 0, kSize, kSize}, {1, 1, 1, 1}, true);
+        list->Barrier(ScopeDraw, ScopeTransfer);
+        list->CopyImageToBuffer(target.get(), readback.get(), {&whole_target, 1});
+        list->Barrier(ScopeTransfer, ScopeHost);
+        list->End();
+        CommandList* lists[] = {list};
+        device->GraphicsQueue().Submit(lists, {}, {fence.get(), 1});
+        if (!fence->Wait(1, 5'000'000'000ULL)) {
+            log += "single list: GPU did not finish\n";
+            return false;
+        }
+        expect("single list", 8, 8, quadrant[0]);
+        expect("single list", 56, 8, quadrant[1]);
+        expect("single list", 8, 56, quadrant[2]);
+        expect("single list", 56, 56, quadrant[3]);
+        log += fmt::format("single list: {}\n", ok ? "picture correct" : "WRONG");
+    }
+
+    // 2. Four threads record a list each (one quadrant, its own tint) at the same time; one
+    //    submission runs them in order, then a fifth list reads back.
+    {
+        const std::array<std::array<float, 4>, 4> tints{{{1, 1, 1, 1}, {0, 1, 1, 1}, {1, 0, 1, 1},
+                                                         {1, 1, 0, 1}}};
+        std::array<CommandList*, 5> lists{};
+        std::vector<std::thread> threads;
+        for (u32 i = 0; i < 4; ++i) {
+            threads.emplace_back([&, i] {
+                CommandList* list = device->AcquireCommandList();
+                list->Begin();
+                const Rect scissor{s32(i % 2 * kSize / 2), s32(i / 2 * kSize / 2), kSize / 2, kSize / 2};
+                for (u32 repeat = 0; repeat < 250; ++repeat) {
+                    draw(list, scissor, tints[i], false);
+                }
+                list->End();
+                lists[i] = list;
+            });
+        }
+        for (auto& thread : threads) {
+            thread.join();
+        }
+        CommandList* tail = device->AcquireCommandList();
+        tail->Begin();
+        tail->Barrier(ScopeDraw, ScopeTransfer);
+        tail->CopyImageToBuffer(target.get(), readback.get(), {&whole_target, 1});
+        tail->Barrier(ScopeTransfer, ScopeHost);
+        tail->End();
+        lists[4] = tail;
+        const auto start = std::chrono::steady_clock::now();
+        device->GraphicsQueue().Submit(lists, {}, {fence.get(), 2});
+        if (!fence->Wait(2, 5'000'000'000ULL)) {
+            log += "four threads: GPU did not finish\n";
+            return false;
+        }
+        const auto ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+        const auto tinted = [&](u32 i) {
+            const Rgba c = quadrant[i];
+            return Rgba{u8(c.r * tints[i][0]), u8(c.g * tints[i][1]), u8(c.b * tints[i][2]), c.a};
+        };
+        const bool before = ok;
+        expect("four threads", 8, 8, tinted(0));
+        expect("four threads", 56, 8, tinted(1));
+        expect("four threads", 8, 56, tinted(2));
+        expect("four threads", 56, 56, tinted(3));
+        log += fmt::format("four threads, 1,000 draws: {} ({:.2f} ms on the GPU)\n",
+                           ok == before ? "picture correct" : "WRONG", ms);
+    }
+
+    // 3. Recording cost: 4,000 draws (a race frame) into one list on one thread.
+    {
+        CommandList* list = device->AcquireCommandList();
+        const auto start = std::chrono::steady_clock::now();
+        list->Begin();
+        RenderingDesc rendering{.width = kSize, .height = kSize, .color_count = 1};
+        rendering.colors[0] = {.view = target_view.get()};
+        list->BeginRendering(rendering);
+        const Viewport viewport{0, 0, float(kSize), float(kSize), 0, 1};
+        const Rect scissor{0, 0, kSize, kSize};
+        const std::array<float, 4> tint{1, 1, 1, 1};
+        for (u32 i = 0; i < 4000; ++i) {
+            list->SetViewports({&viewport, 1});
+            list->SetScissors({&scissor, 1});
+            list->BindPipeline(pipeline.get());
+            list->PushBindings(bindings);
+            list->PushConstants(0, {reinterpret_cast<const u8*>(tint.data()), sizeof(tint)});
+            list->Draw(3, 1, 0, 0);
+        }
+        list->EndRendering();
+        list->End();
+        const auto us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - start).count();
+        CommandList* lists[] = {list};
+        device->GraphicsQueue().Submit(lists, {}, {fence.get(), 3});
+        fence->Wait(3, 5'000'000'000ULL);
+        log += fmt::format("recording 4,000 draws (pipeline, bindings, constants, draw each): {:.0f} us "
+                           "({:.2f} us per draw)\n",
+                           us, us / 4000);
+    }
+    // 4. Secondary lists (each draws one half through a pipeline with dynamic raster, depth and
+    //    stencil state) run from a primary list, as the executor will run render jobs.
+    if (caps.secondary_lists) {
+        GraphicsPipelineDesc dynamic_desc = pipeline_desc;
+        dynamic_desc.dynamic_raster_depth_stencil = true;
+        auto dynamic_pipeline = device->CreateGraphicsPipeline(dynamic_desc);
+        if (!dynamic_pipeline) {
+            log += "dynamic-state pipeline failed\n";
+            return false;
+        }
+        const std::array<std::array<float, 4>, 2> tints{{{0, 0, 1, 1}, {1, 0, 0, 1}}};
+        std::array<CommandList*, 2> secondaries{};
+        for (u32 i = 0; i < 2; ++i) {
+            CommandList* list = device->AcquireCommandList(CommandListLevel::Secondary);
+            list->Begin();
+            RenderingDesc rendering{.width = kSize, .height = kSize, .color_count = 1};
+            rendering.colors[0] = {.view = target_view.get()};
+            list->BeginRendering(rendering);
+            const Viewport viewport{0, 0, float(kSize), float(kSize), 0, 1};
+            const Rect scissor{0, s32(i * kSize / 2), kSize, kSize / 2};
+            list->SetViewports({&viewport, 1});
+            list->SetScissors({&scissor, 1});
+            list->BindPipeline(dynamic_pipeline.get());
+            list->SetRasterState({});
+            list->SetDepthStencilState({});
+            list->PushBindings(bindings);
+            list->PushConstants(0, {reinterpret_cast<const u8*>(tints[i].data()), sizeof(tints[i])});
+            list->Draw(3, 1, 0, 0);
+            list->EndRendering();
+            list->End();
+            secondaries[i] = list;
+        }
+        CommandList* primary = device->AcquireCommandList();
+        primary->Begin();
+        primary->ExecuteSecondary(secondaries);
+        primary->Barrier(ScopeDraw, ScopeTransfer);
+        primary->CopyImageToBuffer(target.get(), readback.get(), {&whole_target, 1});
+        primary->Barrier(ScopeTransfer, ScopeHost);
+        primary->End();
+        CommandList* lists[] = {primary};
+        device->GraphicsQueue().Submit(lists, {}, {fence.get(), 4});
+        if (!fence->Wait(4, 5'000'000'000ULL)) {
+            log += "secondary lists: GPU did not finish\n";
+            return false;
+        }
+        for (CommandList* secondary : secondaries) {
+            device->MarkExecuted(secondary, {fence.get(), 4});
+        }
+        const bool before = ok;
+        const auto tinted = [&](u32 q, u32 t) {
+            const Rgba c = quadrant[q];
+            return Rgba{u8(c.r * tints[t][0]), u8(c.g * tints[t][1]), u8(c.b * tints[t][2]), c.a};
+        };
+        expect("secondary lists", 8, 8, tinted(0, 0));
+        expect("secondary lists", 56, 8, tinted(1, 0));
+        expect("secondary lists", 8, 56, tinted(2, 1));
+        expect("secondary lists", 56, 56, tinted(3, 1));
+        log += fmt::format("secondary lists with dynamic state: {}\n",
+                           ok == before ? "picture correct" : "WRONG");
+    }
+
+    // 5. A layout with more bindings than can be pushed takes a descriptor set per draw.
+    {
+        std::vector<BindingSlot> many(caps.max_push_bindings + 8);
+        for (u32 i = 0; i < many.size(); ++i) {
+            many[i] = {i, i == 1 ? BindingType::Sampler : BindingType::SampledImage, StagePixel};
+        }
+        auto big_layout = device->CreatePipelineLayout(
+            {.bindings = many, .push_constant_bytes = 16, .push_constant_stages = StagePixel});
+        GraphicsPipelineDesc big_desc = pipeline_desc;
+        big_desc.layout = big_layout.get();
+        auto big_pipeline = big_layout ? device->CreateGraphicsPipeline(big_desc) : nullptr;
+        if (!big_pipeline) {
+            log += "pipeline with many bindings failed\n";
+            return false;
+        }
+        CommandList* list = device->AcquireCommandList();
+        list->Begin();
+        RenderingDesc rendering{.width = kSize, .height = kSize, .color_count = 1};
+        rendering.colors[0] = {.view = target_view.get(), .load = LoadOp::Clear, .clear = {0, 0, 0, 0}};
+        list->BeginRendering(rendering);
+        const Viewport viewport{0, 0, float(kSize), float(kSize), 0, 1};
+        const Rect scissor{0, 0, kSize, kSize};
+        const std::array<float, 4> tint{1, 1, 1, 1};
+        list->SetViewports({&viewport, 1});
+        list->SetScissors({&scissor, 1});
+        list->BindPipeline(big_pipeline.get());
+        list->PushBindings(bindings);
+        list->PushConstants(0, {reinterpret_cast<const u8*>(tint.data()), sizeof(tint)});
+        list->Draw(3, 1, 0, 0);
+        list->EndRendering();
+        list->Barrier(ScopeDraw, ScopeTransfer);
+        list->CopyImageToBuffer(target.get(), readback.get(), {&whole_target, 1});
+        list->Barrier(ScopeTransfer, ScopeHost);
+        list->End();
+        CommandList* lists[] = {list};
+        device->GraphicsQueue().Submit(lists, {}, {fence.get(), 5});
+        if (!fence->Wait(5, 5'000'000'000ULL)) {
+            log += "many bindings: GPU did not finish\n";
+            return false;
+        }
+        const bool before = ok;
+        expect("many bindings", 8, 8, quadrant[0]);
+        expect("many bindings", 56, 56, quadrant[3]);
+        log += fmt::format("{} bindings through a descriptor set: {}\n", many.size(),
+                           ok == before ? "picture correct" : "WRONG");
+    }
+
+    // 6. Compute with a specialization constant writing a storage buffer.
+    {
+        constexpr u32 kCount = 256;
+        auto output = device->CreateBuffer({.size = kCount * 4,
+                                            .usage = BufferUsageStorage | BufferUsageTransferSrc,
+                                            .memory = MemoryKind::Readback});
+        const std::array<BindingSlot, 1> compute_slots{{{0, BindingType::StorageBuffer, StageCompute}}};
+        auto compute_layout = device->CreatePipelineLayout({.bindings = compute_slots});
+        const std::array<SpecConstant, 1> constants{{{0, 1000}}};
+        auto compute = compute_layout && output
+                           ? device->CreateComputePipeline(
+                                 {.layout = compute_layout.get(),
+                                  .shader = {ShaderStage::Compute,
+                                             std::span<const u32>{NATIVE_TEST_COMP}, "main",
+                                             constants}})
+                           : nullptr;
+        if (!compute) {
+            log += "compute pipeline failed\n";
+            return false;
+        }
+        CommandList* list = device->AcquireCommandList();
+        list->Begin();
+        list->BindPipeline(compute.get());
+        const Binding out_binding{.slot = 0, .type = BindingType::StorageBuffer, .buffer = output.get(),
+                                  .size = kCount * 4};
+        list->PushBindings({&out_binding, 1});
+        list->Dispatch(kCount / 64, 1, 1);
+        list->Barrier(ScopeCompute, ScopeHost);
+        list->End();
+        CommandList* lists[] = {list};
+        device->GraphicsQueue().Submit(lists, {}, {fence.get(), 6});
+        if (!fence->Wait(6, 5'000'000'000ULL)) {
+            log += "compute: GPU did not finish\n";
+            return false;
+        }
+        u32 wrong = 0;
+        for (u32 i = 0; i < kCount; ++i) {
+            u32 value;
+            std::memcpy(&value, output->Mapped() + i * 4, 4);
+            wrong += value != 1000 + i;
+        }
+        ok = ok && wrong == 0;
+        log += fmt::format("compute with a specialization constant: {}\n",
+                           wrong == 0 ? "values correct" : fmt::format("{} WRONG values", wrong));
+    }
+
+    device->Collect();
+    return ok;
+}
+
+} // namespace
+
+extern "C" __declspec(dllexport) int RytyNativeRhiSelfTest(char* report, int report_size) {
+    std::string log;
+    const bool ok = RunSelfTest(log);
+    log += ok ? "NAT-012 self test passed\n" : "NAT-012 self test FAILED\n";
+    if (report && report_size > 0) {
+        const size_t n = std::min<size_t>(log.size(), static_cast<size_t>(report_size) - 1);
+        std::memcpy(report, log.data(), n);
+        report[n] = '\0';
+    }
+    return ok ? 0 : 1;
+}
diff --git a/ryty_gpu/native/rhi/rhi_vulkan.cpp b/ryty_gpu/native/rhi/rhi_vulkan.cpp
new file mode 100644
index 00000000..d111ec37
--- /dev/null
+++ b/ryty_gpu/native/rhi/rhi_vulkan.cpp
@@ -0,0 +1,1918 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <algorithm>
+#include <atomic>
+#include <bit>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#include "common/assert.h"
+#include "common/logging/log.h"
+#include "ryty_gpu/native/rhi/rhi_vulkan.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+#include "video_core/renderer_vulkan/vk_platform.h"
+#include "sdl_window.h"
+#include "video_core/renderer_vulkan/vk_scheduler.h"
+
+#include <vk_mem_alloc.h>
+
+namespace Native::Rhi {
+namespace {
+
+vk::Format ToVk(Format format) {
+    return static_cast<vk::Format>(static_cast<u32>(format));
+}
+
+bool IsDepthFormat(vk::Format format) {
+    switch (format) {
+    case vk::Format::eD16Unorm:
+    case vk::Format::eD32Sfloat:
+    case vk::Format::eX8D24UnormPack32:
+    case vk::Format::eD16UnormS8Uint:
+    case vk::Format::eD24UnormS8Uint:
+    case vk::Format::eD32SfloatS8Uint:
+        return true;
+    default:
+        return false;
+    }
+}
+bool HasStencil(vk::Format format) {
+    return format == vk::Format::eD16UnormS8Uint || format == vk::Format::eD24UnormS8Uint ||
+           format == vk::Format::eD32SfloatS8Uint || format == vk::Format::eS8Uint;
+}
+
+vk::ImageAspectFlags AspectOf(vk::Format format) {
+    if (!IsDepthFormat(format)) {
+        return format == vk::Format::eS8Uint ? vk::ImageAspectFlagBits::eStencil
+                                             : vk::ImageAspectFlagBits::eColor;
+    }
+    vk::ImageAspectFlags aspect = vk::ImageAspectFlagBits::eDepth;
+    if (HasStencil(format)) {
+        aspect |= vk::ImageAspectFlagBits::eStencil;
+    }
+    return aspect;
+}
+
+vk::ImageAspectFlags ToVkAspect(u8 aspect) {
+    vk::ImageAspectFlags out{};
+    if (aspect & AspectColor) out |= vk::ImageAspectFlagBits::eColor;
+    if (aspect & AspectDepth) out |= vk::ImageAspectFlagBits::eDepth;
+    if (aspect & AspectStencil) out |= vk::ImageAspectFlagBits::eStencil;
+    return out;
+}
+
+vk::ShaderStageFlags ToVkStages(u32 mask) {
+    vk::ShaderStageFlags out{};
+    if (mask & StageVertex) out |= vk::ShaderStageFlagBits::eVertex;
+    if (mask & StageHull) out |= vk::ShaderStageFlagBits::eTessellationControl;
+    if (mask & StageDomain) out |= vk::ShaderStageFlagBits::eTessellationEvaluation;
+    if (mask & StageGeometry) out |= vk::ShaderStageFlagBits::eGeometry;
+    if (mask & StagePixel) out |= vk::ShaderStageFlagBits::eFragment;
+    if (mask & StageCompute) out |= vk::ShaderStageFlagBits::eCompute;
+    return out;
+}
+
+vk::ShaderStageFlagBits ToVkStage(ShaderStage stage) {
+    switch (stage) {
+    case ShaderStage::Vertex: return vk::ShaderStageFlagBits::eVertex;
+    case ShaderStage::Hull: return vk::ShaderStageFlagBits::eTessellationControl;
+    case ShaderStage::Domain: return vk::ShaderStageFlagBits::eTessellationEvaluation;
+    case ShaderStage::Geometry: return vk::ShaderStageFlagBits::eGeometry;
+    case ShaderStage::Pixel: return vk::ShaderStageFlagBits::eFragment;
+    case ShaderStage::Compute: return vk::ShaderStageFlagBits::eCompute;
+    }
+    return vk::ShaderStageFlagBits::eVertex;
+}
+
+vk::DescriptorType ToVk(BindingType type) {
+    switch (type) {
+    case BindingType::UniformBuffer: return vk::DescriptorType::eUniformBuffer;
+    case BindingType::StorageBuffer: return vk::DescriptorType::eStorageBuffer;
+    case BindingType::SampledImage: return vk::DescriptorType::eSampledImage;
+    case BindingType::StorageImage: return vk::DescriptorType::eStorageImage;
+    case BindingType::Sampler: return vk::DescriptorType::eSampler;
+    case BindingType::UniformTexelBuffer: return vk::DescriptorType::eUniformTexelBuffer;
+    case BindingType::StorageTexelBuffer: return vk::DescriptorType::eStorageTexelBuffer;
+    }
+    return vk::DescriptorType::eUniformBuffer;
+}
+
+vk::Filter ToVk(Filter filter) {
+    return filter == Filter::Linear ? vk::Filter::eLinear : vk::Filter::eNearest;
+}
+vk::SamplerMipmapMode ToVkMip(Filter filter) {
+    return filter == Filter::Linear ? vk::SamplerMipmapMode::eLinear : vk::SamplerMipmapMode::eNearest;
+}
+vk::SamplerAddressMode ToVk(AddressMode mode) {
+    switch (mode) {
+    case AddressMode::Repeat: return vk::SamplerAddressMode::eRepeat;
+    case AddressMode::MirroredRepeat: return vk::SamplerAddressMode::eMirroredRepeat;
+    case AddressMode::ClampToEdge: return vk::SamplerAddressMode::eClampToEdge;
+    case AddressMode::ClampToBorder: return vk::SamplerAddressMode::eClampToBorder;
+    case AddressMode::MirrorClampToEdge: return vk::SamplerAddressMode::eMirrorClampToEdge;
+    }
+    return vk::SamplerAddressMode::eRepeat;
+}
+vk::CompareOp ToVk(CompareOp op) {
+    return static_cast<vk::CompareOp>(static_cast<u32>(op)); // same order as VkCompareOp
+}
+vk::StencilOp ToVk(StencilOp op) {
+    return static_cast<vk::StencilOp>(static_cast<u32>(op)); // same order as VkStencilOp
+}
+vk::BlendFactor ToVk(BlendFactor factor) {
+    return static_cast<vk::BlendFactor>(static_cast<u32>(factor)); // same order as VkBlendFactor
+}
+vk::BlendOp ToVk(BlendOp op) {
+    return static_cast<vk::BlendOp>(static_cast<u32>(op)); // same order as VkBlendOp
+}
+vk::PrimitiveTopology ToVk(Topology topology) {
+    switch (topology) {
+    case Topology::PointList: return vk::PrimitiveTopology::ePointList;
+    case Topology::LineList: return vk::PrimitiveTopology::eLineList;
+    case Topology::LineStrip: return vk::PrimitiveTopology::eLineStrip;
+    case Topology::TriangleList: return vk::PrimitiveTopology::eTriangleList;
+    case Topology::TriangleStrip: return vk::PrimitiveTopology::eTriangleStrip;
+    case Topology::TriangleFan: return vk::PrimitiveTopology::eTriangleFan;
+    case Topology::PatchList: return vk::PrimitiveTopology::ePatchList;
+    }
+    return vk::PrimitiveTopology::eTriangleList;
+}
+vk::ComponentSwizzle ToVk(Swizzle swizzle) {
+    switch (swizzle) {
+    case Swizzle::Identity: return vk::ComponentSwizzle::eIdentity;
+    case Swizzle::Zero: return vk::ComponentSwizzle::eZero;
+    case Swizzle::One: return vk::ComponentSwizzle::eOne;
+    case Swizzle::R: return vk::ComponentSwizzle::eR;
+    case Swizzle::G: return vk::ComponentSwizzle::eG;
+    case Swizzle::B: return vk::ComponentSwizzle::eB;
+    case Swizzle::A: return vk::ComponentSwizzle::eA;
+    }
+    return vk::ComponentSwizzle::eIdentity;
+}
+vk::ImageViewType ToVk(ViewDim dim) {
+    switch (dim) {
+    case ViewDim::D1: return vk::ImageViewType::e1D;
+    case ViewDim::D1Array: return vk::ImageViewType::e1DArray;
+    case ViewDim::D2: return vk::ImageViewType::e2D;
+    case ViewDim::D2Array: return vk::ImageViewType::e2DArray;
+    case ViewDim::D3: return vk::ImageViewType::e3D;
+    case ViewDim::Cube: return vk::ImageViewType::eCube;
+    case ViewDim::CubeArray: return vk::ImageViewType::eCubeArray;
+    }
+    return vk::ImageViewType::e2D;
+}
+
+// Pipeline stages and memory accesses of a barrier scope.
+void ScopeToVk(u32 scope, bool source, vk::PipelineStageFlags2& stages, vk::AccessFlags2& access) {
+    using S = vk::PipelineStageFlagBits2;
+    using A = vk::AccessFlagBits2;
+    if (scope & ScopeDraw) {
+        stages |= S::eAllGraphics;
+        access |= source ? (A::eShaderWrite | A::eColorAttachmentWrite | A::eDepthStencilAttachmentWrite)
+                         : (A::eMemoryRead | A::eMemoryWrite);
+    }
+    if (scope & ScopeCompute) {
+        stages |= S::eComputeShader;
+        access |= source ? A::eShaderWrite : (A::eMemoryRead | A::eMemoryWrite);
+    }
+    if (scope & ScopeTransfer) {
+        stages |= S::eAllTransfer;
+        access |= source ? A::eTransferWrite : (A::eTransferRead | A::eTransferWrite);
+    }
+    if (scope & ScopeHost) {
+        stages |= S::eHost;
+        access |= source ? A::eHostWrite : (A::eHostRead | A::eHostWrite);
+    }
+    if (!stages) {
+        stages = source ? S::eTopOfPipe : S::eBottomOfPipe;
+    }
+}
