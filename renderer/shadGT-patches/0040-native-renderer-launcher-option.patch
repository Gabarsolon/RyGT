+        const vk::SemaphoreWaitInfo info{
+            .semaphoreCount = 1,
+            .pSemaphores = &semaphore,
+            .pValues = &value,
+        };
+        return device.waitSemaphores(info, timeout_ns) == vk::Result::eSuccess;
+    }
+    vk::Device device;
+    vk::Semaphore semaphore;
+    bool owned;
+};
