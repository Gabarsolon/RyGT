From 4afc4f92a34b5c1711b55ba09b604f24184da983 Mon Sep 17 00:00:00 2001
From: mlgprorektm8 <67933lance@gmail.com>
Date: Fri, 16 Oct 2026 14:28:29 -0500
Subject: [PATCH 2/2] FIX-104: pause frame generation while shaders compile

With frame generation on, heavy shader compiling deadlocked: FFX's present
thread waited in the driver while pipeline builds and the recorder waited on
its locks (reproduced with both renderers; the new renderer starts with an
empty shader store, so it met it in the menus). Generated frames are turned
off while the game is held for compiles, in slow motion, or while any pipeline
build runs, and for a second after. Two runs with Lance's settings and an
empty store: no freeze (two of two froze before).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ryty_gpu/ryty_framegen.cpp                      | 17 +++++++++++++++++
 .../renderer_vulkan/vk_graphics_pipeline.cpp    |  8 ++++++++
 .../renderer_vulkan/vk_pipeline_cache.h         |  2 ++
 3 files changed, 27 insertions(+)

diff --git a/ryty_gpu/ryty_framegen.cpp b/ryty_gpu/ryty_framegen.cpp
index 5cd1fd6f..66c66a94 100644
--- a/ryty_gpu/ryty_framegen.cpp
+++ b/ryty_gpu/ryty_framegen.cpp
@@ -11,7 +11,9 @@
 
 #include "common/logging/log.h"
 #include "core/emulator_settings.h"
+#include "common/guest_clock.h"
 #include "ryty_gpu/ryty_framegen.h"
+#include "video_core/renderer_vulkan/vk_pipeline_cache.h"
 #include "ryty_gpu/ryty_fsr3.h"
 #include "video_core/renderer_vulkan/vk_instance.h"
 #include "video_core/renderer_vulkan/vk_platform.h"
@@ -347,6 +349,21 @@ void FrameGen::Prepare(vk::CommandBuffer cmdbuf, vk::SwapchainKHR swapchain, vk:
             ab_seconds[0] = ab_seconds[1] = 0.0;
         }
     }
+    // FIX-104: no generated frames while new shaders compile (and for a second after). With
+    // generation on during heavy compiles the driver deadlocked: FFX's present thread waited in
+    // the driver while pipeline builds and the recorder waited on its locks (October 16, both
+    // renderers; the new one compiles its own shaders at first, so it met it at once).
+    {
+        static std::chrono::steady_clock::time_point last_compile{};
+        if (Common::GuestClock::IsPaused() || Vulkan::CompileSlowMotion() ||
+            Vulkan::PipelineBuildsRunning() > 0) {
+            last_compile = now;
+        }
+        if (last_compile != std::chrono::steady_clock::time_point{} &&
+            now - last_compile < std::chrono::seconds{1}) {
+            enabled = false;
+        }
+    }
     config.frameGenerationEnabled = enabled;
     config.allowAsyncWorkloads = false;
     config.HUDLessColor = FfxApiResource{};
diff --git a/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp b/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
index 11a0694e..415d82fe 100644
--- a/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
+++ b/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
@@ -75,6 +75,12 @@ void DumpThreadStacks(const wchar_t* file_name) {
 void DumpThreadStacks(const wchar_t*) {}
 #endif
 
+// FIX-104: pipeline creations in progress (frame generation pauses meanwhile).
+static std::atomic<u32> g_builds_running{0};
+u32 PipelineBuildsRunning() {
+    return g_builds_running.load(std::memory_order_relaxed);
+}
+
 namespace {
 
 // DIAG-049: graphics pipeline creations the driver takes long on, logged every 2 s while they
@@ -83,6 +89,7 @@ namespace {
 class BuildWatch {
 public:
     BuildWatch(std::string name_, const char* what_) : name{std::move(name_)}, what{what_} {
+        g_builds_running.fetch_add(1, std::memory_order_relaxed); // FIX-104
         auto& state = State();
         std::scoped_lock lk{state.mutex};
         id = ++state.next_id;
@@ -93,6 +100,7 @@ public:
         }
     }
     ~BuildWatch() {
+        g_builds_running.fetch_sub(1, std::memory_order_relaxed); // FIX-104
         auto& state = State();
         std::scoped_lock lk{state.mutex};
         const auto it = state.running.find(id);
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.h b/src/video_core/renderer_vulkan/vk_pipeline_cache.h
index 24f7c8af..f58e5e7a 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.h
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.h
@@ -74,6 +74,8 @@ PrecompileProgress GetPrecompileProgress();
 bool PrecompileHoldsGame();
 /// PERF-103: the game runs in slow motion while pipelines it needs are compiled.
 bool CompileSlowMotion();
+/// FIX-104: pipeline creations in progress.
+u32 PipelineBuildsRunning();
 
 class PipelineCache {
 public:
