+            const bool low = !boosted && (background || backlog);
+            if (low != low_priority) {
+                low_priority = low;
                 Common::SetCurrentThreadPriority(low_priority ? Common::ThreadPriority::Low
                                                               : Common::ThreadPriority::Normal);
             }
